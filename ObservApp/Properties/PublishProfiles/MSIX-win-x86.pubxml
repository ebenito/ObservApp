<?xml version="1.0" encoding="utf-8"?>
<!--
  Perfil de publicación MSIX x86. Ver MSIX-win-x64.pubxml: se usa RuntimeIdentifierOverride
  en lugar de RuntimeIdentifier para no contaminar el TFM Android.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PublishDir>bin\Release\net10.0-windows10.0.26100.0\win-x86\publish\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <RuntimeIdentifierOverride>win-x86</RuntimeIdentifierOverride>
    <Platform>Any CPU</Platform>
    <Configuration>Release</Configuration>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <SelfContained>True</SelfContained>
    <PublishAppxPackage>true</PublishAppxPackage>
    <AppxPackageDir>C:\Proyectos\XTV\ObservApp\ObservApp\AppPackages\</AppxPackageDir>
  </PropertyGroup>
</Project>
