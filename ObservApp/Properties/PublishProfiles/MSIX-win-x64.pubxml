<?xml version="1.0" encoding="utf-8"?>
<!--
  Perfil de publicación MSIX x64 (Visual Studio: Publicar / Crear paquetes de aplicación).
  No fijar <RuntimeIdentifier> aquí: se aplica a todos los TFM del proyecto, contamina el
  TFM Android y el restore pide Microsoft.NETCore.App.Runtime.Mono.win-x64 (NU1102), igual
  que ocurría en la CI. ObservApp.csproj convierte RuntimeIdentifierOverride en
  RuntimeIdentifier solo para el TFM de Windows.
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PublishDir>bin\Release\net10.0-windows10.0.26100.0\win-x64\publish\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <RuntimeIdentifierOverride>win-x64</RuntimeIdentifierOverride>
    <Platform>Any CPU</Platform>
    <Configuration>Release</Configuration>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <SelfContained>True</SelfContained>
    <PublishAppxPackage>true</PublishAppxPackage>
    <AppxPackageDir>C:\Proyectos\XTV\ObservApp\ObservApp\AppPackages\</AppxPackageDir>
  </PropertyGroup>
</Project>
