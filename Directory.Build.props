<?xml version="1.0" encoding="utf-8"?>
<Project>
	<!-- ========================================
			 GitVersion Configuration

			 En GitHub Actions: GitVersion /output buildserver establece env vars GITVERSION_*
			 En compilaciones locales: usa fallback estático
			 ======================================== -->

	<PropertyGroup>
		<!-- Si GitVersion ejecutó en CI/CD, estas variables de entorno están disponibles -->
		<!-- buildserver output genera: GITVERSION_SEMVER, GITVERSION_MAJOR, etc. -->

		<Version Condition="'$(GITVERSION_SEMVER)' != ''">$(GITVERSION_SEMVER)</Version>
		<FileVersion Condition="'$(GITVERSION_FULLSEMVER)' != ''">$(GITVERSION_FULLSEMVER)</FileVersion>
		<InformationalVersion Condition="'$(GITVERSION_INFORMATIONALVERSION)' != ''">$(GITVERSION_INFORMATIONALVERSION)</InformationalVersion>
		<ApplicationDisplayVersion Condition="'$(GITVERSION_MAJOR)' != '' and '$(GITVERSION_MINOR)' != ''">$(GITVERSION_MAJOR).$(GITVERSION_MINOR)</ApplicationDisplayVersion>

		<!-- Fallback para compilaciones locales sin GitVersion -->
		<Version Condition="'$(Version)' == ''">1.3.2</Version>
		<FileVersion Condition="'$(FileVersion)' == ''">1.3.2.0</FileVersion>
		<InformationalVersion Condition="'$(InformationalVersion)' == ''">1.3.2</InformationalVersion>
		<ApplicationDisplayVersion Condition="'$(ApplicationDisplayVersion)' == ''">1.3</ApplicationDisplayVersion>
	</PropertyGroup>
</Project>




