@inject AppState AppState
@inject IAuthService AuthService
@inject NavigationManager NavManager

@if (AppState.IsAuthenticated)
{
    @ChildContent
}

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string RedirectTo { get; set; } = "/login";

    protected override async Task OnInitializedAsync()
    {
        if (AppState.IsAuthenticated)
        {
            return;
        }

        // Al recargar la página (o entrar por URL directa) AppState arranca vacío aunque
        // haya una sesión guardada. Intentar restaurarla antes de expulsar al usuario.
        try
        {
            if (await AuthService.TryRestoreSessionAsync())
            {
                AppState.CurrentUser = AuthService.CurrentUser;
            }
        }
        catch
        {
            // Sin sesión restaurable: se redirige a continuación.
        }

        if (!AppState.IsAuthenticated)
        {
            // Sin forceLoad: una recarga completa reinicia el WASM y pierde el estado en memoria.
            NavManager.NavigateTo(RedirectTo);
        }
    }
}
