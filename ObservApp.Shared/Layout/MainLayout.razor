@inherits LayoutComponentBase
@using Syncfusion.Blazor.Navigations
@using Microsoft.Extensions.Localization
@using ObservApp.Shared.Services
@inject NavigationManager NavManager
@inject IStringLocalizer<ObservApp.Resources.Strings.App> L
@inject ILocalizationService Localization
@inject IAppLifecycleService AppLifecycle
@inject IAuthService AuthService
@inject AppState AppState
@inject IJSRuntime JS
@inject INavigationHistoryService HistoryService
@implements IDisposable

<!-- AppBar -->
<div class="obs-appbar">
    <div class="obs-appbar-left">
        <button class="obs-hamburger" @onclick="ToggleSidebar" aria-label="@L["Nav_Home"]">
            <span></span>
            <span></span>
            <span></span>
        </button>
        <div class="obs-brand">
            <span class="obs-brand-star">★</span>
            <span class="obs-brand-name">@L["AppName"]</span>
        </div>
    </div>
    <div class="obs-appbar-right">
        <span class="obs-version">@L["AppVersion"]</span>
    </div>
</div>

<!-- Sidebar + contenido -->
<div class="obs-shell">

    <SfSidebar @ref="_sidebar"
               @bind-IsOpen="_sidebarOpen"
               Width="260px"
               Type="SidebarType.Over"
               ShowBackdrop="true"
               CloseOnDocumentClick="true"
               ZIndex="1200"
               CssClass="obs-sidebar">

        <div class="obs-sidebar-header">
            <span class="obs-brand-star" style="font-size:1.4rem;">★</span>
            <span class="obs-brand-name" style="font-size:1rem;">@L["AppName"]</span>
            <button class="obs-sidebar-close" @onclick="CloseSidebar" aria-label="@L["Action_Close"]">✕</button>
        </div>

        <nav class="obs-nav">

            <div class="obs-nav-group-label">@L["Nav_Section_Main"]</div>
            <a class="obs-nav-link @IsActive("/")" href="/" @onclick="CloseSidebar">
                <span class="obs-nav-icon">🏠</span> @L["Nav_Home"]
            </a>
            <a class="obs-nav-link @IsActive("/mapa")" href="/mapa" @onclick="CloseSidebar">
                <span class="obs-nav-icon">🗺️</span> @L["Nav_Map"]
            </a>

            <div class="obs-nav-group-label">@L["Nav_Section_Planning"]</div>
            @if (AppState.IsAuthenticated)
            {
                <a class="obs-nav-link @IsActive("/planificacion")" href="/planificacion" @onclick="CloseSidebar">
                    <span class="obs-nav-icon">📅</span> @L["Nav_Planning"]
                </a>
            }
            <a class="obs-nav-link @IsActive("/efemerides")" href="/efemerides" @onclick="CloseSidebar">
                <span class="obs-nav-icon">🌙</span> @L["Nav_Ephemeris"]
            </a>

            <div class="obs-nav-group-label">@L["Nav_Section_Tools"]</div>
            <a class="obs-nav-link @IsActive("/calculadoras")" href="/calculadoras" @onclick="CloseSidebar">
                <span class="obs-nav-icon">🧮</span> @L["Nav_Calculators"]
            </a>
            <a class="obs-nav-link @IsActive("/senales")" href="/senales" @onclick="CloseSidebar">
                <span class="obs-nav-icon">📡</span> @L["Nav_Signals"]
            </a>

            <div class="obs-nav-group-label">@L["Nav_Section_Personal"]</div>
            @if (AppState.IsAuthenticated)
            {
                <a class="obs-nav-link @IsActive("/historial")" href="/historial" @onclick="CloseSidebar">
                    <span class="obs-nav-icon">📜</span> @L["Nav_History"]
                </a>
            }
            <a class="obs-nav-link @IsActive("/configuracion")" href="/configuracion" @onclick="CloseSidebar">
                <span class="obs-nav-icon">⚙️</span> @L["Nav_Settings"]
            </a>

            @if (AppState.IsAuthenticated)
            {
                <div class="obs-user-block">
                    <div class="obs-user-name">@AppState.UserDisplayName</div>
                    <button class="obs-nav-link obs-nav-exit" @onclick="SignOutAsync">
                        <span class="obs-nav-icon">🚪</span> @L["Nav_SignOut"]
                    </button>
                </div>
            }
            else
            {
                <a class="obs-nav-link @IsActive("/login")" href="/login" @onclick="CloseSidebar">
                    <span class="obs-nav-icon">🔑</span> @L["Nav_SignIn"]
                </a>
            }

            <a class="obs-nav-link @IsActive("/about")" href="/about" @onclick="CloseSidebar">
                <span class="obs-nav-icon">ℹ️</span> @L["Nav_About"]
            </a>

            @if (AppLifecycle.CanExit)
            {
                <div class="obs-nav-divider"></div>
                <button class="obs-nav-link obs-nav-exit" @onclick="ExitAppAsync">
                    <span class="obs-nav-icon">🚪</span> @L["Nav_Exit"]
                </button>
            }

        </nav>

        <div class="obs-sidebar-footer">
            <span>@L["AppName"] @L["AppVersion"] MAUI</span>
        </div>

    </SfSidebar>

    <main class="obs-main">
        <div class="obs-content">
            @Body
        </div>
    </main>

</div>

@code {
    private SfSidebar _sidebar = default!;
    private bool _sidebarOpen = false;

    protected override void OnInitialized()
    {
        NavManager.LocationChanged += OnLocationChanged;
        Localization.OnLanguageChanged += OnLanguageChanged;
        AppState.OnAuthChanged += OnAppStateChanged;
        AuthService.OnAuthStateChanged += OnAuthStateChanged;

        // Registrar la URL actual en el historial de navegación
        var currentUri = new Uri(NavManager.Uri);
        HistoryService.PushUrl(currentUri.PathAndQuery);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await ApplyHtmlLangAsync();
    }

    private async void OnLanguageChanged()
    {
        await ApplyHtmlLangAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void OnAppStateChanged() => InvokeAsync(StateHasChanged);

    private void OnAuthStateChanged(UserProfile? userProfile)
    {
        AppState.CurrentUser = userProfile;
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task ApplyHtmlLangAsync()
    {
        var code = Localization.CurrentLanguageCode;
        var dir  = code == "ar" ? "rtl" : "ltr";
        await JS.InvokeVoidAsync("ObservApp.applyLang", code, dir);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _sidebarOpen = false;

        // Registrar la nueva URL en el historial de navegación
        var uri = new Uri(e.Location);
        HistoryService.PushUrl(uri.PathAndQuery);

        InvokeAsync(StateHasChanged);
    }

    private void ToggleSidebar() => _sidebarOpen = !_sidebarOpen;
    private void CloseSidebar()  => _sidebarOpen = false;

    private string IsActive(string href)
    {
        var current = "/" + NavManager.ToBaseRelativePath(NavManager.Uri);
        return href == "/"
            ? current == "/" ? "active" : string.Empty
            : current.StartsWith(href, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;
    }

    public void Dispose()
    {
        NavManager.LocationChanged -= OnLocationChanged;
        Localization.OnLanguageChanged -= OnLanguageChanged;
        AppState.OnAuthChanged -= OnAppStateChanged;
        AuthService.OnAuthStateChanged -= OnAuthStateChanged;
    }

    private async Task ExitAppAsync()
    {
        await CloseSidebarAsync();
        await AppLifecycle.ExitApplicationAsync();
    }

    private async Task SignOutAsync()
    {
        await CloseSidebarAsync();
        await AuthService.SignOutAsync();
        AppState.CurrentUser = null;
        NavManager.NavigateTo("/login");
    }

    private async Task CloseSidebarAsync()
    {
        _sidebarOpen = false;
        await InvokeAsync(StateHasChanged);
        // Pequeña pausa para que el sidebar se cierre visualmente antes de salir
        await Task.Delay(150);
    }
}
