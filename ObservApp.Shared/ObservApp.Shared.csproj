<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-windows10.0.26100.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ObservApp</RootNamespace>
    <UserSecretsId>350fa6d5-6ac7-4a95-9403-9a763b027e68</UserSecretsId>
    <!-- Version se genera automáticamente por GitVersion en Directory.Build.props -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="10.0.14" />

    <!-- Syncfusion Blazor -->
    <PackageReference Include="Syncfusion.Blazor.Core" Version="35.1.43" />
    <PackageReference Include="Syncfusion.Blazor.Navigations" Version="35.1.43" />
    <PackageReference Include="Syncfusion.Blazor.Buttons" Version="35.1.43" />
    <PackageReference Include="Syncfusion.Blazor.Inputs" Version="35.1.43" />
    <PackageReference Include="Syncfusion.Blazor.Themes" Version="35.1.43" />
    <PackageReference Include="Syncfusion.Blazor.DropDowns" Version="35.1.43" />
    <!--<PackageReference Include="Syncfusion.Blazor.Grid" Version="34.1.32" />
    <PackageReference Include="Syncfusion.Blazor.Charts" Version="34.1.32" />
    <PackageReference Include="Syncfusion.Blazor.Maps" Version="34.1.32" />
    <PackageReference Include="Syncfusion.Blazor.Notifications" Version="34.1.32" />
    <PackageReference Include="Syncfusion.Blazor.Popups" Version="34.1.32" />
    <PackageReference Include="Syncfusion.Blazor.Spinner" Version="34.1.32" />
    <PackageReference Include="Syncfusion.Blazor.Cards" Version="34.1.32" />
    <PackageReference Include="Syncfusion.Blazor.Calendars" Version="34.1.32" />-->

    <!-- Supabase — nombre correcto desde v1.x -->
    <PackageReference Include="Supabase" Version="8.9.0" />

    <!-- MVVM Community Toolkit -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />

    <!-- Astronomy Engine — cálculos offline de planetas, luna, eclipses -->
    <PackageReference Include="CosineKitty.AstronomyEngine" Version="2.1.19" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\dso-catalog.json">
      <LogicalName>ObservApp.Shared.Resources.dso-catalog.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="GitVersion.MsBuild" Version="6.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Helpers internos (p. ej. parseo de la WP API) accesibles desde los tests -->
    <InternalsVisibleTo Include="ObservApp.Shared.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Login.razor.css es CSS aislado; con un ámbito común lo comparten Login, ConfirmOtp y ResetPassword -->
    <None Update="Pages\Login\Login.razor.css" CssScope="b-login-shared" />
    <Content Update="Pages\Login\*.razor" CssScope="b-login-shared" />
  </ItemGroup>

</Project>