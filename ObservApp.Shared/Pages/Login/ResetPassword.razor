@page "/reset-password"
@using Microsoft.AspNetCore.Components
@inject IStringLocalizer<ObservApp.Resources.Strings.App> L
@inject IAuthService AuthService
@inject AppState AppState
@inject NavigationManager NavManager

<PageTitle>@L["AppName"] · @L["Auth_Reset_Title"]</PageTitle>

<div class="login-page">
    <div class="login-shell">
        <header class="login-header">
            <span class="login-star">★</span>
            <h1 class="login-brand">@L["AppName"]</h1>
        </header>

        <section class="login-card">
            <div class="login-card__intro">
                <p class="login-kicker">@L["Auth_Reset_Title"]</p>
                <h2 class="login-title">@StepTitle</h2>
            </div>

            @if (_step == Step.Email)
            {
                <p class="login-forgot">@L["Auth_Reset_Description"]</p>
            }
            else if (_step == Step.Code)
            {
                <p class="login-forgot">
                    @L["Auth_Otp_Description_Prefix"] <strong>@Email</strong>. @L["Auth_Otp_Description_Suffix"]
                </p>
            }
            else
            {
                <p class="login-forgot">@L["Auth_Reset_PasswordDescription"]</p>
            }

            @if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <div class="login-error" role="alert">@_errorMessage</div>
            }

            @if (_isLoading)
            {
                <div class="login-loading" aria-live="polite">
                    <span class="login-spinner" aria-hidden="true"></span>
                    <span>@LoadingText</span>
                </div>
            }

            <div class="login-fields">
                @if (_step == Step.Email)
                {
                    <div class="login-field">
                        <label class="login-label" for="reset-email">@L["Auth_Email"]</label>
                        <input id="reset-email"
                               class="login-input"
                               type="email"
                               autocomplete="email"
                               value="@Email"
                               @oninput="OnEmailInput" />
                    </div>
                }
                else if (_step == Step.Code)
                {
                    <div class="login-field">
                        <label class="login-label" for="reset-code">@L["Auth_Otp_Code_Label"]</label>
                        <input id="reset-code"
                               class="login-input"
                               inputmode="numeric"
                               maxlength="8"
                               autocomplete="one-time-code"
                               value="@_code"
                               @oninput="OnCodeInput" />
                    </div>
                }
                else
                {
                    <div class="login-field">
                        <label class="login-label" for="new-password">@L["Auth_Reset_NewPassword"]</label>
                        <div class="login-password-row">
                            <input id="new-password"
                                   class="login-input login-input--password"
                                   type="@(_showPassword ? "text" : "password")"
                                   autocomplete="new-password"
                                   value="@_newPassword"
                                   @oninput="OnNewPasswordInput" />
                            <button type="button"
                                    class="login-password-toggle"
                                    @onclick="() => _showPassword = !_showPassword"
                                    aria-label="@(_showPassword ? L["Action_Hide"] : L["Action_Show"])">
                                @(_showPassword ? "🙈" : "👁️")
                            </button>
                        </div>
                    </div>

                    <div class="login-field">
                        <label class="login-label" for="confirm-new-password">@L["Auth_ConfirmPassword"]</label>
                        <div class="login-password-row">
                            <input id="confirm-new-password"
                                   class="login-input login-input--password"
                                   type="@(_showConfirmPassword ? "text" : "password")"
                                   autocomplete="new-password"
                                   value="@_confirmPassword"
                                   @oninput="OnConfirmPasswordInput" />
                            <button type="button"
                                    class="login-password-toggle"
                                    @onclick="() => _showConfirmPassword = !_showConfirmPassword"
                                    aria-label="@(_showConfirmPassword ? L["Action_Hide"] : L["Action_Show"])">
                                @(_showConfirmPassword ? "🙈" : "👁️")
                            </button>
                        </div>
                    </div>

                    @if (_newPassword.Length > 0 && _newPassword.Length < MinPasswordLength)
                    {
                        <div class="login-inline-error">@string.Format(L["Auth_PasswordTooShort"], MinPasswordLength)</div>
                    }
                    else if (!PasswordsMatch)
                    {
                        <div class="login-inline-error">@L["Auth_PasswordMismatch"]</div>
                    }
                }
            </div>

            <div class="login-actions">
                <button type="button"
                        class="login-primary"
                        @onclick="SubmitAsync"
                        disabled="@IsSubmitDisabled">
                    @SubmitText
                </button>

                @if (_step == Step.Code)
                {
                    <button type="button"
                            class="login-secondary"
                            @onclick="ResendCodeAsync"
                            disabled="@_isLoading">
                        @L["Auth_Reset_ResendCode"]
                    </button>
                }
            </div>

            <button type="button" class="login-toggle" @onclick="BackToLogin">
                @L["Auth_Reset_BackToLogin"]
            </button>
        </section>
    </div>
</div>

@code {
    private const int MinPasswordLength = 6;

    private enum Step { Email, Code, Password }

    [Parameter]
    [SupplyParameterFromQuery(Name = "email")]
    public string? Email { get; set; }

    private Step _step = Step.Email;
    private string _code = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private bool _showPassword;
    private bool _showConfirmPassword;
    private bool _isLoading;
    private string? _errorMessage;

    private bool PasswordsMatch => string.Equals(_newPassword, _confirmPassword, StringComparison.Ordinal);

    private string StepTitle => _step switch
    {
        Step.Email => L["Auth_Reset_Subtitle_Email"],
        Step.Code => L["Auth_Otp_Subtitle"],
        _ => L["Auth_Reset_NewPassword"],
    };

    private string LoadingText => _step switch
    {
        Step.Email => L["Auth_Reset_Sending"],
        Step.Code => L["Auth_Otp_Verifying"],
        _ => L["Auth_Reset_Updating"],
    };

    private string SubmitText => _step switch
    {
        Step.Email => L["Auth_Reset_SendCode"],
        Step.Code => L["Auth_Reset_VerifyCode"],
        _ => L["Auth_Reset_ChangePassword"],
    };

    private bool IsSubmitDisabled => _isLoading || _step switch
    {
        Step.Email => string.IsNullOrWhiteSpace(Email) || !Email.Contains('@'),
        Step.Code => _code.Length < 6,
        _ => _newPassword.Length < MinPasswordLength || !PasswordsMatch,
    };

    protected override void OnInitialized()
    {
        if (AppState.IsAuthenticated)
        {
            NavManager.NavigateTo("/");
        }
    }

    private void OnEmailInput(Microsoft.AspNetCore.Components.ChangeEventArgs e)
        => Email = e.Value?.ToString() ?? string.Empty;

    private void OnCodeInput(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        var rawValue = e.Value?.ToString() ?? string.Empty;
        _code = new string(rawValue.Where(char.IsDigit).Take(8).ToArray());
    }

    private void OnNewPasswordInput(Microsoft.AspNetCore.Components.ChangeEventArgs e)
        => _newPassword = e.Value?.ToString() ?? string.Empty;

    private void OnConfirmPasswordInput(Microsoft.AspNetCore.Components.ChangeEventArgs e)
        => _confirmPassword = e.Value?.ToString() ?? string.Empty;

    private void BackToLogin() => NavManager.NavigateTo("/login");

    private async Task SubmitAsync()
    {
        if (IsSubmitDisabled)
        {
            return;
        }

        switch (_step)
        {
            case Step.Email:
                await SendCodeAsync();
                break;
            case Step.Code:
                await VerifyCodeAsync();
                break;
            default:
                await ChangePasswordAsync();
                break;
        }
    }

    private async Task ResendCodeAsync()
    {
        _code = string.Empty;
        await SendCodeAsync();
    }

    private async Task SendCodeAsync()
    {
        await RunAsync(async () =>
        {
            var ok = await AuthService.RequestPasswordResetAsync(Email!.Trim());
            if (!ok)
            {
                _errorMessage = AuthService.LastError ?? L["Auth_Reset_Error"];
                return;
            }

            _step = Step.Code;
        });
    }

    private async Task VerifyCodeAsync()
    {
        await RunAsync(async () =>
        {
            var ok = await AuthService.VerifyRecoveryOtpAsync(Email!.Trim(), _code);
            if (!ok)
            {
                _errorMessage = AuthService.LastError ?? L["Auth_Otp_Error"];
                return;
            }

            _step = Step.Password;
        });
    }

    private async Task ChangePasswordAsync()
    {
        await RunAsync(async () =>
        {
            var ok = await AuthService.UpdatePasswordAsync(_newPassword);
            if (!ok)
            {
                _errorMessage = AuthService.LastError ?? L["Auth_Reset_Error"];
                return;
            }

            // La sesión de recuperación queda como sesión normal: el usuario entra directamente.
            AppState.CurrentUser = AuthService.CurrentUser;
            NavManager.NavigateTo("/");
        });
    }

    private async Task RunAsync(Func<Task> action)
    {
        try
        {
            _isLoading = true;
            _errorMessage = null;
            await action();
        }
        catch (Exception ex)
        {
            _errorMessage = string.Format(L["Error_Unexpected"], ex.Message);
        }
        finally
        {
            _isLoading = false;
        }
    }
}
