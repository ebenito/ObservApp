@page "/not-found"
@inject IStringLocalizer<ObservApp.Resources.Strings.App> L

<div style="display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:60vh;gap:16px;">
    <span style="font-size:3rem;">🔭</span>
    <h3 style="color:var(--obs-moon);">@L["NotFound_Title"]</h3>
    <p style="color:var(--obs-comet);">@L["NotFound_Message"]</p>
    <a href="/" style="color:var(--obs-aurora);text-decoration:none;">@L["NotFound_Back"]</a>
</div>
