@page "/calculadoras/soluna"
@using ObservApp.Shared.Models
@using ObservApp.Shared.Services
@inject IStringLocalizer<ObservApp.Resources.Strings.App> L
@inject ISolLunaCalculatorService SolLunaCalculator
@inject IGeolocationService GeoService
@inject IFavoriteLocationsService FavLocationsService
@inject ILocationStateService LocationState

<PageTitle>@L["SolLuna_Title"] — ObservApp</PageTitle>

<div class="soluna-page">

    <!-- Cabecera -->
    <div class="soluna-header-back">
        <BackButton Text="Action_Back" CssClass="soluna-back" DefaultUrl="/calculadoras" />
    </div>
    <div class="soluna-header">
        <span class="soluna-header-icon">🌞🌙</span>
        <div>
            <h1 class="soluna-header-title">@L["SolLuna_Title"]</h1>
            <p class="soluna-header-subtitle">@L["SolLuna_Subtitle"]</p>
        </div>
    </div>

    <!-- Inputs: Fecha y Ubicación -->
    <div class="soluna-inputs-grid">

        <!-- Fecha -->
        <div class="soluna-card">
            <div class="soluna-card-header">
                <span>📅</span> @L["SolLuna_Date"]
            </div>
            <div class="soluna-card-body">
                <input class="soluna-input" type="date"
                       value="@_fecha.ToString("yyyy-MM-dd")"
                       min="1901-01-01" max="2099-01-31"
                       @onchange="OnFechaChanged" />
            </div>
        </div>

        <!-- Ubicación -->
        <LocationPicker CssPrefix="soluna"
                        TitleKey="SolLuna_Location"
                        GpsBtnKey="SolLuna_UseGPS"
                        Locations="_favLocations"
                        IsLoading="_gpsLoading"
                        GpsError="@_gpsError"
                        GpsSource="@_gpsSource"
                        OnGpsRequested="OnUsarGpsAsync"
                        OnFavoriteSelected="OnFavLocationSelected">
            <div class="soluna-card-body soluna-location-body">
                <div class="soluna-field">
                    <label class="soluna-label">@L["SolLuna_Latitude"]</label>
                    <input class="soluna-input" type="number" min="-90" max="90" step="0.0001"
                           @bind="Latitude" />
                </div>
                <div class="soluna-field">
                    <label class="soluna-label">@L["SolLuna_Longitude"]</label>
                    <input class="soluna-input" type="number" min="-180" max="180" step="0.0001"
                           @bind="Longitude" />
                </div>
                <div class="soluna-field">
                    <label class="soluna-label">@L["SolLuna_Altitude"] (m)</label>
                    <input class="soluna-input" type="number" min="-500" max="8900" step="1"
                           @bind="Altitude" />
                </div>
            </div>
        </LocationPicker>

    </div>

    <!-- Pestañas Sol / Luna -->
    <div class="soluna-tabs">
        <button class="soluna-tab @(_tab == Tab.Sol ? "soluna-tab--active" : "")"
                @onclick="() => _tab = Tab.Sol">
            ☀️ @L["SolLuna_Tab_Sun"]
        </button>
        <button class="soluna-tab @(_tab == Tab.Luna ? "soluna-tab--active" : "")"
                @onclick="() => _tab = Tab.Luna">
            🌙 @L["SolLuna_Tab_Moon"]
        </button>
        <button class="soluna-tab @(_tab == Tab.Eventos ? "soluna-tab--active" : "")"
                @onclick="() => _tab = Tab.Eventos">
            🗓️ @L["SolLuna_Tab_Events"]
        </button>
    </div>

    <!-- ═══════════════════ TAB SOL ═══════════════════ -->
    @if (_tab == Tab.Sol && _sol != null)
    {
        <div class="soluna-section-grid">

            <!-- Tiempos clave del Sol -->
            <div class="soluna-card soluna-card--sun">
                <div class="soluna-card-header">
                    ☀️ @L["SolLuna_Sun_Times"]
                </div>
                <div class="soluna-card-body">
                    <div class="soluna-row">
                        <span class="soluna-row-label">@L["SolLuna_Dawn_Astronomical"]</span>
                        <span class="soluna-row-value">@FormatTime(_sol.AstronomicalDawn)</span>
                    </div>
                    <div class="soluna-row">
                        <span class="soluna-row-label">@L["SolLuna_Dawn_Nautical"]</span>
                        <span class="soluna-row-value">@FormatTime(_sol.NauticalDawn)</span>
                    </div>
                    <div class="soluna-row">
                        <span class="soluna-row-label">@L["SolLuna_Dawn_Civil"]</span>
                        <span class="soluna-row-value">@FormatTime(_sol.CivilDawn)</span>
                    </div>
                    <div class="soluna-row soluna-row--highlight">
                        <span class="soluna-row-label">🌅 @L["SolLuna_Sunrise"]</span>
                        <span class="soluna-row-value">@FormatTime(_sol.Sunrise)</span>
                    </div>
                    <div class="soluna-row soluna-row--highlight">
                        <span class="soluna-row-label">🕛 @L["SolLuna_SolarNoon"]</span>
                        <span class="soluna-row-value">@FormatTime(_sol.Transit)</span>
                    </div>
                    <div class="soluna-row soluna-row--highlight">
                        <span class="soluna-row-label">🌇 @L["SolLuna_Sunset"]</span>
                        <span class="soluna-row-value">@FormatTime(_sol.Sunset)</span>
                    </div>
                    <div class="soluna-row">
                        <span class="soluna-row-label">@L["SolLuna_Dusk_Civil"]</span>
                        <span class="soluna-row-value">@FormatTime(_sol.CivilDusk)</span>
                    </div>
                    <div class="soluna-row">
                        <span class="soluna-row-label">@L["SolLuna_Dusk_Nautical"]</span>
                        <span class="soluna-row-value">@FormatTime(_sol.NauticalDusk)</span>
                    </div>
                    <div class="soluna-row">
                        <span class="soluna-row-label">@L["SolLuna_Dusk_Astronomical"]</span>
                        <span class="soluna-row-value">@FormatTime(_sol.AstronomicalDusk)</span>
                    </div>
                    <div class="soluna-row soluna-row--separator">
                        <span class="soluna-row-label">⏱ @L["SolLuna_DayLength"]</span>
                        <span class="soluna-row-value">@FormatDuration(_sol.DayLength)</span>
                    </div>
                </div>
            </div>

            <!-- Posicionamiento del Sol -->
            <div class="soluna-card soluna-card--sun">
                <div class="soluna-card-header">
                    📐 @L["SolLuna_Sun_Position"]
                </div>
                <div class="soluna-card-body">
                    <div class="soluna-row">
                        <span class="soluna-row-label">@L["SolLuna_AzimuthRise"]</span>
                        <span class="soluna-row-value">@FormatAngle(_sol.RiseAzimuthDeg)</span>
                    </div>
                    <div class="soluna-row">
                        <span class="soluna-row-label">@L["SolLuna_AzimuthSet"]</span>
                        <span class="soluna-row-value">@FormatAngle(_sol.SetAzimuthDeg)</span>
                    </div>
                    <div class="soluna-row soluna-row--highlight">
                        <span class="soluna-row-label">@L["SolLuna_MaxAltitude"]</span>
                        <span class="soluna-row-value">@FormatAngle(_sol.MaxAltitudeDeg)</span>
                    </div>
                    <div class="soluna-row">
                        <span class="soluna-row-label">@L["SolLuna_Declination"]</span>
                        <span class="soluna-row-value">@FormatAngle(_sol.DeclinationDeg)</span>
                    </div>
                    <div class="soluna-row">
                        <span class="soluna-row-label">@L["SolLuna_RightAscension"]</span>
                        <span class="soluna-row-value">@FormatRA(_sol.RightAscensionHours)</span>
                    </div>
                    <div class="soluna-row">
                        <span class="soluna-row-label">@L["SolLuna_EquationOfTime"]</span>
                        <span class="soluna-row-value">@FormatEOT(_sol.EquationOfTimeMinutes)</span>
                    </div>
                    <div class="soluna-row">
                        <span class="soluna-row-label">@L["SolLuna_Distance"]</span>
                        <span class="soluna-row-value">@_sol.DistanceAu.ToString("N3") @L["SolLuna_Unit_AU"]</span>
                    </div>
                </div>
            </div>

        </div>

        <!-- Camino solar -->
        @if (_sol.Path.Count > 0)
        {
            <div class="soluna-card soluna-card--sun soluna-card--full">
                <div class="soluna-card-header">
                    📈 @L["SolLuna_Sun_Path"]
                </div>
                <div class="soluna-card-body">
                    <div class="soluna-path-chart" id="soluna-sun-path">
                        @foreach (var pt in _sol.Path)
                        {
                            var x = (pt.Hour / 24.0) * 100.0;
                            var altNorm = Math.Clamp((pt.AltitudeDeg + 18) / (_sol.MaxAltitudeDeg + 20), 0, 1);
                            var y = (1.0 - altNorm) * 100.0;
                            var color = pt.AltitudeDeg < -18 ? "var(--obs-night)" :
                                        pt.AltitudeDeg < -12 ? "#1a2a4a" :
                                        pt.AltitudeDeg < -6 ? "#2d4a7a" :
                                        pt.AltitudeDeg < 0 ? "var(--obs-aurora)" :
                                        pt.AltitudeDeg < 20 ? "#f59e0b" : "var(--obs-star)";
                            <div class="soluna-path-dot" title="@pt.Hour:00 — @FormatAngle(pt.AltitudeDeg)"
                                 style="left:@(x.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%;
                                        top:@(y.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%;
                                        background:@color;"></div>
                        }
                        <!-- Línea horizonte -->
                        <div class="soluna-path-horizon"></div>
                        <!-- Etiquetas horas -->
                        @foreach (var h in new[] { 0, 3, 6, 9, 12, 15, 18, 21 })
                        {
                            <span class="soluna-path-hlabel"
                                  style="left:@((h / 24.0 * 100).ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%">@h:00</span>
                        }
                    </div>
                    <div class="soluna-path-legend">
                        <span class="soluna-legend-item" style="--lc:#1a2a4a">@L["SolLuna_Twi_Astro"]</span>
                        <span class="soluna-legend-item" style="--lc:#2d4a7a">@L["SolLuna_Twi_Naut"]</span>
                        <span class="soluna-legend-item" style="--lc:var(--obs-aurora)">@L["SolLuna_Twi_Civil"]</span>
                        <span class="soluna-legend-item" style="--lc:var(--obs-star)">@L["SolLuna_Daytime"]</span>
                    </div>
                </div>
            </div>
        }
    }
    else if (_tab == Tab.Sol)
    {
        <div class="soluna-empty">⚠️ @L["SolLuna_NoData"]</div>
    }

    <!-- ═══════════════════ TAB LUNA ═══════════════════ -->
    @if (_tab == Tab.Luna && _luna != null)
    {
        <div class="soluna-section-grid">

            <!-- Tiempos clave de la Luna -->
            <div class="soluna-card soluna-card--moon">
                <div class="soluna-card-header">
                    🌙 @L["SolLuna_Moon_Times"]
                </div>
                <div class="soluna-card-body">
                    <div class="soluna-row">
                        <span class="soluna-row-label">🌕 @L["SolLuna_Moonrise"]</span>
                        <span class="soluna-row-value">@FormatTime(_luna.Moonrise)</span>
                    </div>
                    <div class="soluna-row soluna-row--highlight">
                        <span class="soluna-row-label">🕛 @L["SolLuna_MoonTransit"]</span>
                        <span class="soluna-row-value">@FormatTime(_luna.Transit)</span>
                    </div>
                    <div class="soluna-row">
                        <span class="soluna-row-label">🌑 @L["SolLuna_Moonset"]</span>
                        <span class="soluna-row-value">@FormatTime(_luna.Moonset)</span>
                    </div>
                </div>
            </div>

            <!-- Posicionamiento de la Luna -->
            <div class="soluna-card soluna-card--moon">
                <div class="soluna-card-header">
                    📐 @L["SolLuna_Moon_Position"]
                </div>
                <div class="soluna-card-body">
                    <div class="soluna-row">
                        <span class="soluna-row-label">@L["SolLuna_AzimuthRise"]</span>
                        <span class="soluna-row-value">@FormatAngle(_luna.RiseAzimuthDeg)</span>
                    </div>
                    <div class="soluna-row">
                        <span class="soluna-row-label">@L["SolLuna_AzimuthSet"]</span>
                        <span class="soluna-row-value">@FormatAngle(_luna.SetAzimuthDeg)</span>
                    </div>
                    <div class="soluna-row soluna-row--highlight">
                        <span class="soluna-row-label">@L["SolLuna_MaxAltitude"]</span>
                        <span class="soluna-row-value">@FormatAngle(_luna.MaxAltitudeDeg)</span>
                    </div>
                    <div class="soluna-row">
                        <span class="soluna-row-label">@L["SolLuna_Declination"]</span>
                        <span class="soluna-row-value">@FormatAngle(_luna.DeclinationDeg)</span>
                    </div>
                    <div class="soluna-row">
                        <span class="soluna-row-label">@L["SolLuna_Distance"]</span>
                        <span class="soluna-row-value">@_luna.DistanceKm.ToString("N0") km</span>
                    </div>
                    <div class="soluna-row">
                        <span class="soluna-row-label">@L["SolLuna_AngularDiam"]</span>
                        <span class="soluna-row-value">@FormatAngle(_luna.AngularDiameterDeg)</span>
                    </div>
                </div>
            </div>

            <!-- Fase lunar -->
            <div class="soluna-card soluna-card--moon">
                <div class="soluna-card-header">
                    🌓 @L["SolLuna_Moon_Phase"]
                </div>
                <div class="soluna-card-body">
                    <div class="soluna-phase-display">
                        <span class="soluna-phase-emoji">@PhaseEmoji(_luna.Phase)</span>
                        <span class="soluna-phase-name">@PhaseName(_luna.Phase)</span>
                    </div>
                    <div class="soluna-phase-bar-wrap">
                        <div class="soluna-phase-bar">
                            <div class="soluna-phase-fill" style="width:@(_luna.IlluminationPercent.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                        </div>
                        <span class="soluna-phase-pct">@_luna.IlluminationPercent.ToString("F1")%</span>
                    </div>
                    <div class="soluna-row soluna-row--separator">
                        <span class="soluna-row-label">@L["SolLuna_NextNewMoon"]</span>
                        <span class="soluna-row-value">@_luna.NextNewMoonUtc.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                    <div class="soluna-row">
                        <span class="soluna-row-label">@L["SolLuna_NextFullMoon"]</span>
                        <span class="soluna-row-value">@_luna.NextFullMoonUtc.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                    <div class="soluna-row">
                        <span class="soluna-row-label">@L["SolLuna_LunarAge"]</span>
                        <span class="soluna-row-value">@_luna.AgeDays.ToString("F1") @L["SolLuna_Days"]</span>
                    </div>
                </div>
            </div>

        </div>

        <!-- Camino lunar -->
        @if (_luna.Path.Count > 0)
        {
            <div class="soluna-card soluna-card--moon soluna-card--full">
                <div class="soluna-card-header">
                    📈 @L["SolLuna_Moon_Path"]
                </div>
                <div class="soluna-card-body">
                    <div class="soluna-path-chart">
                        @{
                            var maxAlt = _luna.Path.Max(p => p.AltitudeDeg);
                            var minAlt = _luna.Path.Min(p => p.AltitudeDeg);
                            var rng = Math.Max(maxAlt - minAlt, 10);
                        }
                        @foreach (var pt in _luna.Path)
                        {
                            var x = (pt.Hour / 24.0) * 100.0;
                            var altNorm = Math.Clamp((pt.AltitudeDeg - minAlt) / rng, 0, 1);
                            var y = (1.0 - altNorm) * 100.0;
                            <div class="soluna-path-dot soluna-path-dot--moon"
                                 title="@pt.Hour:00 — @FormatAngle(pt.AltitudeDeg)"
                                 style="left:@(x.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%;
                                        top:@(y.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%;"></div>
                        }
                        <div class="soluna-path-horizon"></div>
                        @foreach (var h in new[] { 0, 3, 6, 9, 12, 15, 18, 21 })
                        {
                            <span class="soluna-path-hlabel"
                                  style="left:@((h / 24.0 * 100).ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%">@h:00</span>
                        }
                    </div>
                </div>
            </div>
        }
    }
    else if (_tab == Tab.Luna)
    {
        <div class="soluna-empty">⚠️ @L["SolLuna_NoData"]</div>
    }

    <!-- ═══════════════════ TAB EVENTOS ═══════════════════ -->
    @if (_tab == Tab.Eventos && _eventos != null)
    {
        <div class="soluna-card soluna-card--events soluna-card--full">
            <div class="soluna-card-header">
                🗓️ @L["SolLuna_Events_Year"] @_fecha.Year
            </div>
            <div class="soluna-card-body">

                <h3 class="soluna-events-subtitle">☀️ @L["SolLuna_Solstices_Equinoxes"]</h3>
                <div class="soluna-events-list">
                    <div class="soluna-event-row">
                        <span class="soluna-event-icon">🌱</span>
                        <span class="soluna-event-label">@L["SolLuna_VernalEquinox"]</span>
                        <span class="soluna-event-date">@_eventos.MarchEquinoxUtc.ToString("dd/MM/yyyy HH:mm") UTC</span>
                    </div>
                    <div class="soluna-event-row">
                        <span class="soluna-event-icon">☀️</span>
                        <span class="soluna-event-label">@L["SolLuna_SummerSolstice"]</span>
                        <span class="soluna-event-date">@_eventos.JuneSolsticeUtc.ToString("dd/MM/yyyy HH:mm") UTC</span>
                    </div>
                    <div class="soluna-event-row">
                        <span class="soluna-event-icon">🍂</span>
                        <span class="soluna-event-label">@L["SolLuna_AutumnalEquinox"]</span>
                        <span class="soluna-event-date">@_eventos.SeptemberEquinoxUtc.ToString("dd/MM/yyyy HH:mm") UTC</span>
                    </div>
                    <div class="soluna-event-row">
                        <span class="soluna-event-icon">❄️</span>
                        <span class="soluna-event-label">@L["SolLuna_WinterSolstice"]</span>
                        <span class="soluna-event-date">@_eventos.DecemberSolsticeUtc.ToString("dd/MM/yyyy HH:mm") UTC</span>
                    </div>
                </div>

                <h3 class="soluna-events-subtitle" style="margin-top:20px;">🌙 @L["SolLuna_Moon_Phases_Year"]</h3>
                <div class="soluna-events-list">
                    @foreach (var fase in _eventos.MoonPhases)
                    {
                        <div class="soluna-event-row">
                            <span class="soluna-event-icon">@PhaseEmoji(fase.Phase)</span>
                            <span class="soluna-event-label">@PhaseName(fase.Phase)</span>
                            <span class="soluna-event-date">@fase.UtcTime.ToString("dd/MM/yyyy HH:mm") UTC</span>
                        </div>
                    }
                </div>

                <h3 class="soluna-events-subtitle" style="margin-top:20px;">🌘 @L["SolLuna_Eclipses_Year"]</h3>
                <div class="soluna-events-list">
                    @foreach (var eclipse in _eventos.Eclipses)
                    {
                        <div class="soluna-event-row">
                            <span class="soluna-event-icon">@EclipseEmoji(eclipse.Body)</span>
                            <span class="soluna-event-label">@EclipseBodyName(eclipse.Body) / @EclipseKindName(eclipse.Kind)</span>
                            <span class="soluna-event-date">@eclipse.PeakUtc.ToString("dd/MM/yyyy HH:mm") UTC</span>
                            <span class="soluna-event-magnitud" title="@L["SolLuna_Magnitude_Desc"]">🌌 @eclipse.Obscuration.ToString("F3")</span>
                            <div class="soluna-event-times">
                                @if (eclipse.C1Utc.HasValue) { <span title="@L["SolLuna_Contact_C1_Desc"]">🕐 @FormatTime(eclipse.C1Utc)</span> }
                                @if (eclipse.C2Utc.HasValue) { <span title="@L["SolLuna_Contact_C2_Desc"]">🕑 @FormatTime(eclipse.C2Utc)</span> }
                                @if (eclipse.C3Utc.HasValue) { <span title="@L["SolLuna_Contact_C3_Desc"]">🕒 @FormatTime(eclipse.C3Utc)</span> }
                                @if (eclipse.C4Utc.HasValue) { <span title="@L["SolLuna_Contact_C4_Desc"]">🕓 @FormatTime(eclipse.C4Utc)</span> }
                            </div>
                        </div>
                    }
                </div>

            </div>
        </div>
    }
    else if (_tab == Tab.Eventos)
    {
        <div class="soluna-empty">⚠️ @L["SolLuna_NoData"]</div>
    }

</div>

@code {
    // ── Enumeración de pestañas ───────────────────────────────────────────────
    private enum Tab { Sol, Luna, Eventos }
    private Tab _tab = Tab.Sol;

    // ── Parámetros de entrada ─────────────────────────────────────────────────
    private DateTime _fecha = DateTime.Today;

    private double _lat;
    private double Latitude
    {
        get => _lat;
        set { _lat = Math.Clamp(value, -90, 90); Calcular(); }
    }

    private double _lon;
    private double Longitude
    {
        get => _lon;
        set { _lon = Math.Clamp(value, -180, 180); Calcular(); }
    }

    private double _altMetros;
    private double Altitude
    {
        get => _altMetros;
        set { _altMetros = value; Calcular(); }
    }

    // ── Ubicaciones Favoritas ─────────────────────────────────────────────────
    private List<FavoriteLocation>? _favLocations;

    // ── Estado GPS ───────────────────────────────────────────────────────────
    private bool _gpsLoading;
    private string? _gpsError;
    private string? _gpsSource;

    // ── Resultados ────────────────────────────────────────────────────────────
    private SolLunaSunData? _sol;
    private SolLunaMoonData? _luna;
    private SolLunaYearEvents? _eventos;

    // ── Ciclo de vida ─────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        // Inyectar el manejador de cambios de ubicación
        LocationState.LocationChanged += OnLocationStateChanged;

        _favLocations = await FavLocationsService.GetFavoriteLocationsAsync();

        // Inicializar el servicio centralizado (obtiene GPS real o fallback)
        await LocationState.InitializeAsync();

        // Sincronizar valores locales con el estado compartido
        SyncFromLocationState();

        Calcular();
    }

    /// <summary>
    /// Se dispara cuando cambia la ubicación en el servicio centralizado.
    /// </summary>
    private void OnLocationStateChanged(object? sender, LocationStateChangedEventArgs e)
    {
        SyncFromLocationState();
        Calcular();
        StateHasChanged();
    }

    /// <summary>
    /// Sincroniza los valores locales de ubicación desde el servicio centralizado.
    /// </summary>
    private void SyncFromLocationState()
    {
        _lat = LocationState.CurrentLocation.Latitude;
        _lon = LocationState.CurrentLocation.Longitude;
        _altMetros = LocationState.CurrentLocation.AltitudeMeters;
        _gpsSource = LocationState.CurrentLocation.Label;
        _gpsError = null;
    }

    private async Task OnFavLocationSelected(string val)
    {
        if (val == "manual")
        {
            // Deja que edite manual
        }
        else if (val == "gps")
        {
            await OnUsarGpsAsync();
        }
        else if (Guid.TryParse(val, out var id))
        {
            var loc = _favLocations?.Find(l => l.Id == id);
            if (loc != null)
            {
                LocationState.SetFavoriteLocation(loc);
            }
        }
    }

    // ── GPS ───────────────────────────────────────────────────────────────────
    private async Task OnUsarGpsAsync()
    {
        _gpsLoading = true;
        _gpsError = null;
        _gpsSource = null;
        StateHasChanged();

        await LocationState.SetGpsLocationAsync();
        _gpsError = LocationState.LastError;

        _gpsLoading = false;
        StateHasChanged();
    }

    // ── Handlers ─────────────────────────────────────────────────────────────
    private void OnFechaChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var d))
        {
            _fecha = d;
            Calcular();
        }
    }

    // ── Cálculo (delegado en ISolLunaCalculatorService) ──────────────────────
    private void Calcular()
    {
        try
        {
            var result = SolLunaCalculator.Calculate(_fecha, _lat, _lon, _altMetros);
            _sol = result.Sun;
            _luna = result.Moon;
            _eventos = result.Events;
        }
        catch
        {
            _sol = null;
            _luna = null;
            _eventos = null;
        }
    }

    // ── Helpers de presentación ───────────────────────────────────────────────
    private string PhaseName(MoonPhaseKind phase) => phase switch
    {
        MoonPhaseKind.WaxingCrescent => L["SolLuna_Phase_WaxCrescent"],
        MoonPhaseKind.FirstQuarter => L["SolLuna_Phase_FirstQuarter"],
        MoonPhaseKind.WaxingGibbous => L["SolLuna_Phase_WaxGibbous"],
        MoonPhaseKind.Full => L["SolLuna_Phase_Full"],
        MoonPhaseKind.WaningGibbous => L["SolLuna_Phase_WanGibbous"],
        MoonPhaseKind.LastQuarter => L["SolLuna_Phase_LastQuarter"],
        MoonPhaseKind.WaningCrescent => L["SolLuna_Phase_WanCrescent"],
        _ => L["SolLuna_Phase_New"]
    };

    private static string PhaseEmoji(MoonPhaseKind phase) => phase switch
    {
        MoonPhaseKind.WaxingCrescent => "🌒",
        MoonPhaseKind.FirstQuarter => "🌓",
        MoonPhaseKind.WaxingGibbous => "🌔",
        MoonPhaseKind.Full => "🌕",
        MoonPhaseKind.WaningGibbous => "🌖",
        MoonPhaseKind.LastQuarter => "🌗",
        MoonPhaseKind.WaningCrescent => "🌘",
        _ => "🌑"
    };

    private string EclipseBodyName(SolLunaEclipseBody body)
        => body == SolLunaEclipseBody.Solar ? L["SolLuna_Eclipse_Solar"] : L["SolLuna_Eclipse_Lunar"];

    private static string EclipseEmoji(SolLunaEclipseBody body)
        => body == SolLunaEclipseBody.Solar ? "☀️" : "🌕";

    private string EclipseKindName(SolLunaEclipseKind kind) => kind switch
    {
        SolLunaEclipseKind.Total => L["SolLuna_Eclipse_Total"],
        SolLunaEclipseKind.Annular => L["SolLuna_Eclipse_Annular"],
        SolLunaEclipseKind.Penumbral => L["SolLuna_Eclipse_Penumbral"],
        _ => L["SolLuna_Eclipse_Partial"]
    };

    // ── Helpers de formato ────────────────────────────────────────────────────
    private string FormatTime(DateTime? dt)
        => dt.HasValue ? dt.Value.ToLocalTime().ToString("HH:mm") : "—";

    private string FormatAngle(double deg)
        => double.IsNaN(deg) ? "—" : $"{deg:F1}°";

    private string FormatRA(double ra)
        => double.IsNaN(ra) ? "—" : $"{ra:F3} h";

    private string FormatEOT(double min)
        => double.IsNaN(min) ? "—" : $"{(min >= 0 ? "+" : "")}{min:F1} min";

    private static string FormatDuration(TimeSpan? ts)
        => ts.HasValue ? $"{(int)ts.Value.TotalHours}h {ts.Value.Minutes:D2}m" : "—";
}
