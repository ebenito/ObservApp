@using Microsoft.AspNetCore.Components

<div class="eph-dso-cb-item">
    <span class="eph-dso-cb-avatar @AvatarClass">
        <span class="eph-dso-cb-svg-icon">@((MarkupString)SvgContent)</span>
    </span>
    <span class="eph-dso-cb-text">
        <span class="eph-dso-cb-title">@Label</span>
        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <span class="eph-dso-cb-subtitle">@Subtitle</span>
        }
    </span>
</div>

@code {
    [Parameter, EditorRequired] public string AvatarClass { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter, EditorRequired] public string SvgContent { get; set; } = string.Empty;
}
