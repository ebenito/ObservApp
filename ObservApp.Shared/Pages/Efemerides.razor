    private int _calcGeneration;

    // ── Motor de cálculo ─────────────────────────────────────────────────────
    // Async para no bloquear el hilo de UI: el trabajo pesado (planetas +
    // búsqueda de próximo eclipse) se ejecuta en un Task.Run. Se usa un
    // contador de generación para descartar resultados obsoletos si el
    // usuario cambia fecha/ubicación varias veces seguidas antes de que
    // termine un cálculo anterior.
    private async Task CalcularAsync()
    {
        var generation = ++_calcGeneration;
        var fecha = _fecha;
        var lat = _lat;
        var lon = _lon;
        var alt = _altMetros;

        try
        {
            var (computation, eclipse, eclipseResult) = await Task.Run(() =>
            {
                var comp = EphAstronomyService.Compute(fecha, lat, lon, alt);
                var (ecl, eclResult) = EphAstronomyService.FindNextVisibleEclipse(
                    DateTime.UtcNow, lat, lon, alt, yearsAhead: 2);
                return (comp, ecl, eclResult);
            });

            if (generation != _calcGeneration)
            {
                // Ha llegado una entrada más reciente mientras calculábamos
                // esta; descartamos el resultado para no pisar datos nuevos
                // con otros ya obsoletos.
                return;
            }

            _planetas = computation.Planets
                .Select(p => new PlanetData
                {
                    Name = p.Name,
                    Emoji = p.Emoji,
                    Body = p.Body,
                    IsVisible = p.IsVisible,
                    MaxAltitude = p.MaxAltitude,
                    AzimuthAtMax = p.AzimuthAtMax,
                    RiseTime = p.RiseTime,
                    SetTime = p.SetTime,
                    DistanceAU = p.DistanceAU,
                    IlluminationPct = p.IlluminationPct
                })
                .ToList();

            _eventos = computation.Events
                .Select(e => new EphEvent { Emoji = e.Emoji, Date = e.Date, Description = e.Description })
                .ToList();

            _tonight = computation.Tonight is null
                ? null
                : new TonightData
                {
                    MoonIlluminationPct = computation.Tonight.MoonIlluminationPct,
                    MoonPhaseName = EfemeridesUiFormatter.MoonPhaseName(L, computation.Tonight.MoonPhaseAngle),
                    MoonPhaseEmoji = EfemeridesUiFormatter.MoonPhaseEmoji(computation.Tonight.MoonPhaseAngle),
                    AstroNightStart = computation.Tonight.AstroNightStart,
                    MoonRise = computation.Tonight.MoonRise,
                    MoonSet = computation.Tonight.MoonSet,
                    Quality = computation.Tonight.Quality switch
                    {
                        EphNightQuality.Good => NightQuality.Good,
                        EphNightQuality.Fair => NightQuality.Fair,
                        _ => NightQuality.Poor
                    }
                };

            _nextLocalEclipse = eclipse;
            _nextLocalEclipseResult = eclipseResult;

            _ = CalcularDsosAsync();
        }
        catch (Exception ex)
        {
            if (generation != _calcGeneration)
            {
                // Error de un cálculo ya obsoleto: no pisar el estado actual.
                return;
            }

            Logger.LogError(ex,
                "Error calculando efemérides para fecha={Fecha}, lat={Lat}, lon={Lon}, alt={Alt}",
                fecha, lat, lon, alt);

            _planetas = new();
            _eventos = new();
            _tonight = null;
            _nextLocalEclipse = null;
            _nextLocalEclipseResult = null;
            _dsoVisibles = new();
            _dsoNightStartUtc = null;
            _dsoNightEndUtc = null;
            _dsoLoading = false;
        }
    }

    private async Task CalcularDsosAsync()
    {
        _calcCts?.Cancel();
        _calcCts?.Dispose();
        _calcCts = new CancellationTokenSource();
        var token = _calcCts.Token;

        _dsoLoading = true;
        _dsoVisibles = new();
        _dsoNightStartUtc = null;
        _dsoNightEndUtc = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            await Task.Run(() =>
            {
                var dsoCatalog = DsoCatalog;
                var catalogById = new Dictionary<string, DsoEntry>(dsoCatalog.Count);
                var catalog = new List<EphDsoCoordinate>(dsoCatalog.Count);
                foreach (var d in dsoCatalog)
                {
                    catalogById[d.Id] = d;
                    catalog.Add(new EphDsoCoordinate
                    {
                        Id = d.Id,
                        RaDeg = d.RaDeg,
                        DecDeg = d.DecDeg,
                        Magnitude = d.Magnitude
                    });
                }

                var (window, visible) = EphAstronomyService.ComputeDsoVisibility(
                    _fecha,
                    _lat,
                    _lon,
                    _altMetros,
                    catalog,
                    token);

                token.ThrowIfCancellationRequested();

                var mapped = visible
                    .Select(v => catalogById.TryGetValue(v.Id, out var dso)
                        ? new DsoVisibility
                        {
                            Dso = dso,
                            IsVisibleTonight = v.IsVisibleTonight,
                            MaxAltitude = v.MaxAltitude,
                            AzimuthAtMax = v.AzimuthAtMax,
                            VisibleFrom = v.VisibleFrom,
                            VisibleUntil = v.VisibleUntil,
                            BestViewingTime = v.BestViewingTime,
                            VisibleStartPercent = v.VisibleStartPercent,
                            VisibleWidthPercent = v.VisibleWidthPercent
                        }
                        : null)
                    .Where(v => v is not null)
                    .Cast<DsoVisibility>()
                    .ToList();

                InvokeAsync(() =>
                {
                    if (!IsCurrentCalc(token))
                    {
                        return;
                    }

                    _dsoNightStartUtc = window?.StartUtc;
                    _dsoNightEndUtc = window?.EndUtc;
                    _dsoVisibles = mapped;
                    StateHasChanged();
                });
            }, token);
        }
        catch (OperationCanceledException)
        {
            // Operación cancelada normalmente (ej: usuario navegó/recargó la página)
            // No es necesario hacer nada - es el comportamiento esperado
        }
        finally
        {
            if (IsCurrentCalc(token))
            {
                _dsoLoading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private bool IsCurrentCalc(CancellationToken token)
        => _calcCts is not null && _calcCts.Token == token;


