    // ── Ciclo de vida ─────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        VM.OnStateChanged += OnVmStateChanged;
        await VM.InitializeAsync();
        Calcular();
    }

    private void OnVmStateChanged()
    {
        Calcular();
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        VM.OnStateChanged -= OnVmStateChanged;
        VM.Dispose();
        _calcCts?.Cancel();
        _calcCts?.Dispose();
    }

