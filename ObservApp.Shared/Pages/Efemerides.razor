@page "/efemerides"
@using CosineKitty
@using System.Globalization
@using ObservApp.Shared.Models
@using ObservApp.Shared.Formatters
@using ObservApp.Shared.Models.PageModels
@using ObservApp.Shared.Services
@using ObservApp.Shared.ViewModels
@implements IDisposable
@inject IStringLocalizer<ObservApp.Resources.Strings.App> L
@inject IEfemeridesAstronomyService EphAstronomyService
@inject IDsoCatalogProvider DsoCatalogProvider
@inject EfemeridesViewModel VM

<PageTitle>@L["Eph_Title"] — ObservApp</PageTitle>

<div class="eph-page">

    <!-- Cabecera -->
    <div class="eph-header-back">
        <a class="eph-back" href="/">← @L["Action_Back"]</a>
    </div>
    <div class="eph-header">
        <span class="eph-header-icon">🔭</span>
        <div>
            <h1 class="eph-header-title">@L["Eph_Title"]</h1>
            <p class="eph-header-subtitle">@L["Eph_Subtitle"]</p>
        </div>
    </div>

    <!-- Inputs: Fecha y Ubicación -->
    <div class="eph-inputs-grid">

        <!-- Fecha -->
        <div class="eph-card">
            <div class="eph-card-header">
                <span class="eph-card-icon">📅</span>
                <span class="eph-card-title">@L["Eph_Date"]</span>
            </div>
            <div class="eph-card-body">
                <input class="eph-input" type="date"
                       value="@_fecha.ToString("yyyy-MM-dd")"
                       min="1901-01-01" max="2099-12-31"
                       @onchange="OnFechaChanged" />
            </div>
        </div>

        <!-- Ubicación -->
        <LocationPicker CssPrefix="eph"
                        TitleKey="Eph_Location"
                        GpsBtnKey="SolLuna_UseGPS"
                        Locations="_favLocations"
                        IsLoading="_gpsLoading"
                        GpsError="@_gpsError"
                        GpsSource="@_gpsSource"
                        OnGpsRequested="OnUsarGpsAsync"
                        OnFavoriteSelected="OnFavLocationSelected">
            <div class="eph-card-body eph-location-body">
                <div class="eph-field">
                    <label class="eph-label">@L["SolLuna_Latitude"]</label>
                    <input class="eph-input" type="number" min="-90" max="90" step="0.0001"
                           value="@_lat.ToString(CultureInfo.InvariantCulture)"
                           @onchange="OnLatChanged" />
                </div>
                <div class="eph-field">
                    <label class="eph-label">@L["SolLuna_Longitude"]</label>
                    <input class="eph-input" type="number" min="-180" max="180" step="0.0001"
                           value="@_lon.ToString(CultureInfo.InvariantCulture)"
                           @onchange="OnLonChanged" />
                </div>
                <div class="eph-field">
                    <label class="eph-label">@L["SolLuna_Altitude"] (m)</label>
                    <input class="eph-input" type="number" min="-500" max="8900" step="1"
                           value="@_altMetros.ToString(CultureInfo.InvariantCulture)"
                           @onchange="OnAltChanged" />
                </div>
            </div>
        </LocationPicker>

    </div>

    @if (_nextLocalEclipse != null && _nextLocalEclipseResult != null)
    {
        <div class="eph-eclipse-banner @EfemeridesUiFormatter.EclipseBannerClass(_nextLocalEclipseResult.Type)">
            <div class="eph-eclipse-banner-icon">@EfemeridesUiFormatter.EclipseEmoji(_nextLocalEclipseResult.Type)</div>
            <div class="eph-eclipse-banner-body">
                <div class="eph-eclipse-banner-title">@L["Eph_Eclipse_BannerTitle"]</div>
                <div class="eph-eclipse-banner-main">
                    <span class="eph-eclipse-banner-type">@EfemeridesUiFormatter.EclipseTypeLabel(L, _nextLocalEclipseResult.Type)</span>
                    <span class="eph-eclipse-banner-date">@_nextLocalEclipse.Date.ToLocalTime().ToString("dd MMM yyyy", CultureInfo.CurrentCulture)</span>
                </div>
                <div class="eph-eclipse-banner-meta">
                    <span>@L["Eph_Eclipse_Coverage"]</span>
                    <strong>@((_nextLocalEclipseResult.MaxCoverage * 100.0).ToString("F0", CultureInfo.InvariantCulture))%</strong>
                    <span class="eph-eclipse-banner-sep">•</span>
                    <strong>@EfemeridesUiFormatter.DaysUntilEclipse(_nextLocalEclipse.Date)</strong>
                    <span>@L["Eph_Eclipse_DaysLeft"]</span>
                </div>
            </div>
            <a class="eph-eclipse-banner-link" href="/calculadoras/eclipse-solar">@L["Eph_Eclipse_Details"]</a>
        </div>
    }
    <!-- Sección 2: Tabla de planetas -->
    <div class="eph-card eph-card--full eph-section">
        <div class="eph-card-header">
            <span class="eph-card-icon">🪐</span>
            <span class="eph-card-title">@L["Eph_Planets_Title"]</span>
        </div>
        @if (_planetas == null || _planetas.Count == 0)
        {
            <div class="eph-empty">@L["Eph_Planets_Empty"]</div>
        }
        else
        {
            <!-- Vista tabla (≥640px) -->
            <div class="eph-planets-table-wrapper">
                <table class="eph-planets-table">
                    <thead>
                        <tr>
                            <th>@L["Eph_Planet_Name"]</th>
                            <th>@L["Eph_Planet_Status"]</th>
                            <th>@L["Eph_Planet_MaxAlt"]</th>
                            <th>@L["Eph_Planet_Rise"]</th>
                            <th>@L["Eph_Planet_Set"]</th>
                            <th>@L["Eph_Planet_Azimuth"]</th>
                            <th>@L["Eph_Planet_Distance"]</th>
                            <th>@L["Eph_Planet_Illumination"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in _planetas)
                        {
                            <tr class="@(p.IsVisible ? "eph-row--visible" : "eph-row--hidden")">
                                <td class="eph-planet-name">
                                    <span class="eph-planet-emoji">@p.Emoji</span>
                                    @p.Name
                                </td>
                                <td>
                                    @if (p.IsVisible)
                                    {
                                        <span class="eph-badge eph-badge--visible">@L["Eph_Planet_Visible"]</span>
                                    }
                                    else
                                    {
                                        <span class="eph-badge eph-badge--hidden">@L["Eph_Planet_NotVisible"]</span>
                                    }
                                </td>
                                <td class="eph-mono">@p.MaxAltitude.ToString("F1", CultureInfo.InvariantCulture)°</td>
                                <td class="eph-mono">@EfemeridesUiFormatter.FormatTimeOpt(p.RiseTime)</td>
                                <td class="eph-mono">@EfemeridesUiFormatter.FormatTimeOpt(p.SetTime)</td>
                                <td class="eph-mono">@p.AzimuthAtMax.ToString("F1", CultureInfo.InvariantCulture)°</td>
                                <td class="eph-mono">@p.DistanceAU.ToString("F3", CultureInfo.InvariantCulture) UA</td>
                                <td class="eph-mono">@p.IlluminationPct.ToString("F0", CultureInfo.InvariantCulture)%</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Vista tarjetas (móvil <640px) -->
            <div class="eph-planets-cards">
                @foreach (var p in _planetas)
                {
                    <div class="eph-planet-card @(p.IsVisible ? "eph-planet-card--visible" : "eph-planet-card--hidden")">
                        <div class="eph-planet-card-header">
                            <span class="eph-planet-emoji-lg">@p.Emoji</span>
                            <div>
                                <div class="eph-planet-card-name">@p.Name</div>
                                @if (p.IsVisible)
                                {
                                    <span class="eph-badge eph-badge--visible">@L["Eph_Planet_Visible"]</span>
                                }
                                else
                                {
                                    <span class="eph-badge eph-badge--hidden">@L["Eph_Planet_NotVisible"]</span>
                                }
                            </div>
                        </div>
                        <div class="eph-planet-card-body">
                            <div class="stat-row">
                                <span class="stat-label">@L["Eph_Planet_MaxAlt"]</span>
                                <span class="stat-value">@p.MaxAltitude.ToString("F1", CultureInfo.InvariantCulture)°</span>
                            </div>
                            <div class="stat-row">
                                <span class="stat-label">@L["Eph_Planet_Rise"]</span>
                                <span class="stat-value">@EfemeridesUiFormatter.FormatTimeOpt(p.RiseTime)</span>
                            </div>
                            <div class="stat-row">
                                <span class="stat-label">@L["Eph_Planet_Set"]</span>
                                <span class="stat-value">@EfemeridesUiFormatter.FormatTimeOpt(p.SetTime)</span>
                            </div>
                            <div class="stat-row">
                                <span class="stat-label">@L["Eph_Planet_Azimuth"]</span>
                                <span class="stat-value">@p.AzimuthAtMax.ToString("F1", CultureInfo.InvariantCulture)°</span>
                            </div>
                            <div class="stat-row">
                                <span class="stat-label">@L["Eph_Planet_Distance"]</span>
                                <span class="stat-value">@p.DistanceAU.ToString("F3", CultureInfo.InvariantCulture) UA</span>
                            </div>
                            <div class="stat-row">
                                <span class="stat-label">@L["Eph_Planet_Illumination"]</span>
                                <span class="stat-value">@p.IlluminationPct.ToString("F0", CultureInfo.InvariantCulture)%</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Sección 3: Eventos próximos -->
    <div class="eph-card eph-card--full eph-section">
        <div class="eph-card-header">
            <span class="eph-card-icon">🗓️</span>
            <span class="eph-card-title">@L["Eph_Events_Title"]</span>
        </div>
        @if (_eventos == null || _eventos.Count == 0)
        {
            <div class="eph-empty">@L["Eph_Events_Empty"]</div>
        }
        else
        {
            <div class="eph-events-list">
                @foreach (var ev in _eventos)
                {
                    <div class="eph-event-row">
                        <span class="eph-event-emoji">@ev.Emoji</span>
                        <span class="eph-event-date">@ev.Date.ToString("dd MMM yyyy", CultureInfo.CurrentCulture)</span>
                        <span class="eph-event-desc">@ev.Description</span>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Sección 4: Cielo esta noche -->
    <div class="eph-card eph-card--full eph-section">
        <div class="eph-card-header">
            <span class="eph-card-icon">🌌</span>
            <span class="eph-card-title">@L["Eph_Tonight_Title"]</span>
        </div>
        @if (_tonight != null)
        {
            <div class="eph-card-body">
                <div class="eph-tonight-grid">
                    <div class="eph-tonight-quality @EfemeridesUiFormatter.QualityClass(_tonight.Quality)">
                        <div class="eph-tonight-quality-dot"></div>
                        <div>
                            <div class="eph-tonight-quality-label">@EfemeridesUiFormatter.QualityLabel(L, _tonight.Quality)</div>
                            <div class="eph-tonight-quality-sub">@L["Eph_Moon_Present"]</div>
                        </div>
                    </div>
                    <div class="eph-tonight-info">
                        <div class="stat-row">
                            <span class="stat-label">@L["Eph_Moon_Phase"]</span>
                            <span class="stat-value">@_tonight.MoonPhaseEmoji @_tonight.MoonPhaseName</span>
                        </div>
                        <div class="stat-row">
                            <span class="stat-label">@L["Eph_Moon_Illumination"]</span>
                            <span class="stat-value">@_tonight.MoonIlluminationPct.ToString("F0", CultureInfo.InvariantCulture)%</span>
                        </div>
                        @if (_tonight.AstroNightStart.HasValue)
                        {
                            <div class="stat-row">
                                <span class="stat-label">@L["Eph_Tonight_AstroNight"]</span>
                                <span class="stat-value eph-aurora">@_tonight.AstroNightStart.Value.ToLocalTime().ToString("HH:mm")</span>
                            </div>
                        }
                        else
                        {
                            <div class="stat-row">
                                <span class="stat-label">@L["Eph_Tonight_AstroNight"]</span>
                                <span class="stat-value eph-comet">@L["Eph_Tonight_NoAstroNight"]</span>
                            </div>
                        }
                        @if (_tonight.MoonRise.HasValue)
                        {
                            <div class="stat-row">
                                <span class="stat-label">🌙 @L["Eph_Planet_Rise"]</span>
                                <span class="stat-value">@_tonight.MoonRise.Value.ToLocalTime().ToString("HH:mm")</span>
                            </div>
                        }
                        @if (_tonight.MoonSet.HasValue)
                        {
                            <div class="stat-row">
                                <span class="stat-label">🌙 @L["Eph_Planet_Set"]</span>
                                <span class="stat-value">@_tonight.MoonSet.Value.ToLocalTime().ToString("HH:mm")</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="eph-card eph-card--full eph-section">
        <div class="eph-card-header eph-dso-header">
            <span class="eph-card-icon">🌌</span>
            <div class="eph-dso-header-text">
                <span class="eph-card-title">@L["Eph_DSO_Title"]</span>
                <span class="eph-dso-header-subtitle">@L["Eph_DSO_Subtitle"]</span>
            </div>
            @if (_dsoVisibles.Count > 0)
            {
                <span class="eph-dso-count">@_dsoVisibles.Count @L["Eph_DSO_Count"]</span>
            }
        </div>

        @if (_dsoLoading)
        {
            <div class="eph-card-body eph-dso-loading-wrap">
                <SfSpinner CssClass="eph-dso-spinner" Label="@L["Eph_DSO_Loading"]" Visible="true" />
                <div class="eph-dso-loading-text">@L["Eph_DSO_Loading"]</div>
            </div>
        }
        else if (_dsoVisibles.Count == 0)
        {
            <div class="eph-empty">@L["Eph_DSO_Empty"]</div>
        }
        else
        {
            <div class="eph-dso-list">
                @foreach (var item in _dsoVisibles)
                {
                    <div class="eph-dso-card @EfemeridesUiFormatter.DsoAccentClass(item.Dso.Type)">
                        <div class="eph-dso-media-layout">
                            <div class="eph-dso-thumb-wrap">
                                @if (item.ThumbnailFailed)
                                {
                                    <div class="eph-dso-thumb-fallback" role="img" aria-label="@EfemeridesUiFormatter.DsoThumbnailAltText(item.Dso)">
                                        <span class="eph-dso-thumb-fallback-emoji">@item.Dso.Emoji</span>
                                        <span class="eph-dso-thumb-fallback-id">@item.Dso.Id</span>
                                    </div>
                                }
                                else
                                {
                                    <img class="eph-dso-thumb"
                                         src="@EfemeridesUiFormatter.BuildDsoThumbnailUrl(item.Dso)"
                                         alt="@EfemeridesUiFormatter.DsoThumbnailAltText(item.Dso)"
                                         loading="lazy"
                                         referrerpolicy="no-referrer"
                                         @onerror="() => OnDsoImageError(item)" />
                                }
                            </div>

                            <div class="eph-dso-main">
                                <div class="eph-dso-card-top">
                                    <div class="eph-dso-title-wrap">
                                        <span class="eph-dso-emoji">@item.Dso.Emoji</span>
                                        <div>
                                            <div class="eph-dso-name-line">
                                                <span class="eph-dso-id">@item.Dso.Id</span>
                                                <span class="eph-dso-name">@item.Dso.Name</span>
                                            </div>
                                            <div class="eph-dso-constellation">@L["Eph_DSO_Constellation"]: @item.Dso.Constellation</div>
                                        </div>
                                    </div>
                                    <div class="eph-dso-type-line">@EfemeridesUiFormatter.DsoTypeLabel(L, item.Dso.Type) · @L["Eph_DSO_Magnitude"] @item.Dso.Magnitude.ToString("F1", CultureInfo.InvariantCulture)</div>
                                </div>

                                <div class="eph-dso-stats-grid">
                                    <div class="stat-row">
                                        <span class="stat-label">@L["Eph_DSO_MaxAlt"]</span>
                                        <span class="stat-value">@item.MaxAltitude.ToString("F1", CultureInfo.InvariantCulture)°</span>
                                    </div>
                                    <div class="stat-row">
                                        <span class="stat-label">@L["Eph_DSO_BestTime"]</span>
                                        @EfemeridesUiFormatter.FormatTimeOpt(item.BestViewingTime)
                                    </div>
                                    <div class="stat-row">
                                        <span class="stat-label">@L["Eph_DSO_VisibleFrom"]</span>
                                        @EfemeridesUiFormatter.FormatTimeOpt(item.VisibleFrom)
                                    </div>
                                    <div class="stat-row">
                                        <span class="stat-label">@L["Eph_DSO_VisibleTo"]</span>
                                        @EfemeridesUiFormatter.FormatTimeOpt(item.VisibleUntil)
                                    </div>
                                </div>

                                <div class="eph-dso-track-wrap">
                                    <div class="eph-dso-track-labels">
                                        @EfemeridesUiFormatter.FormatTimeOpt(_dsoNightStartUtc)
                                        @EfemeridesUiFormatter.FormatTimeOpt(_dsoNightEndUtc)
                                    </div>
                                    <div class="eph-dso-track">
                                        <div class="eph-dso-track-visible" style="@EfemeridesUiFormatter.BuildDsoVisibilityStyle(item)"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

</div>

@code {

    // ── Estado ────────────────────────────────────────────────────────────────
    private DateTime _fecha
    {
        get => VM.Fecha;
        set => VM.Fecha = value;
    }

    private double _lat
    {
        get => VM.Latitude;
        set => VM.Latitude = value;
    }

    private double _lon
    {
        get => VM.Longitude;
        set => VM.Longitude = value;
    }

    private double _altMetros
    {
        get => VM.AltitudeMeters;
        set => VM.AltitudeMeters = value;
    }

    private IReadOnlyList<FavoriteLocation> _favLocations => VM.FavoriteLocations;
    private bool _gpsLoading => VM.GpsLoading;
    private string? _gpsError => VM.GpsError;
    private string? _gpsSource => VM.GpsSource;

    private List<PlanetData> _planetas = new();
    private List<EphEvent> _eventos = new();
    private TonightData? _tonight;
    private EclipseDefinition? _nextLocalEclipse;
    private LocalEclipseResult? _nextLocalEclipseResult;
    private List<DsoVisibility> _dsoVisibles = new();
    private bool _dsoLoading;
    private DateTime? _dsoNightStartUtc;
    private DateTime? _dsoNightEndUtc;
    private CancellationTokenSource? _calcCts;

    // ── Ciclo de vida ─────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        VM.OnStateChanged += OnVmStateChanged;
        await VM.InitializeAsync();
        Calcular();
    }

    private void OnVmStateChanged()
    {
        Calcular();
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        VM.OnStateChanged -= OnVmStateChanged;
        VM.Dispose();
        _calcCts?.Cancel();
        _calcCts?.Dispose();
    }

    // ── Handlers de ubicación ─────────────────────────────────────────────────
    private async Task OnFavLocationSelected(string val)
    {
        await VM.SelectLocationAsync(val);
    }

    private async Task OnUsarGpsAsync()
    {
        await VM.UseGpsAsync();
    }

    private void OnFechaChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var d))
        {
            _fecha = d;
            Calcular();
        }
    }

    private void OnLatChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out var v))
        {
            _lat = Math.Clamp(v, -90, 90);
            VM.SetManualLocation(_lat, _lon, _altMetros);
            Calcular();
        }
    }

    private void OnLonChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out var v))
        {
            _lon = Math.Clamp(v, -180, 180);
            VM.SetManualLocation(_lat, _lon, _altMetros);
            Calcular();
        }
    }

    private void OnAltChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out var v))
        {
            _altMetros = v;
            VM.SetManualLocation(_lat, _lon, _altMetros);
            Calcular();
        }
    }

    // ── Motor de cálculo ─────────────────────────────────────────────────────
    private void Calcular()
    {
        try
        {
            var computation = EphAstronomyService.Compute(_fecha, _lat, _lon, _altMetros);
            _planetas = computation.Planets
                .Select(p => new PlanetData
                {
                    Name = p.Name,
                    Emoji = p.Emoji,
                    Body = p.Body,
                    IsVisible = p.IsVisible,
                    MaxAltitude = p.MaxAltitude,
                    AzimuthAtMax = p.AzimuthAtMax,
                    RiseTime = p.RiseTime,
                    SetTime = p.SetTime,
                    DistanceAU = p.DistanceAU,
                    IlluminationPct = p.IlluminationPct
                })
                .ToList();

            _eventos = computation.Events
                .Select(e => new EphEvent { Emoji = e.Emoji, Date = e.Date, Description = e.Description })
                .ToList();

            _tonight = computation.Tonight is null
                ? null
                : new TonightData
                {
                    MoonIlluminationPct = computation.Tonight.MoonIlluminationPct,
                    MoonPhaseName = EfemeridesUiFormatter.MoonPhaseName(computation.Tonight.MoonPhaseAngle),
                    MoonPhaseEmoji = EfemeridesUiFormatter.MoonPhaseEmoji(computation.Tonight.MoonPhaseAngle),
                    AstroNightStart = computation.Tonight.AstroNightStart,
                    MoonRise = computation.Tonight.MoonRise,
                    MoonSet = computation.Tonight.MoonSet,
                    Quality = computation.Tonight.Quality switch
                    {
                        EphNightQuality.Good => NightQuality.Good,
                        EphNightQuality.Fair => NightQuality.Fair,
                        _ => NightQuality.Poor
                    }
                };

            CalcularProximoEclipseLocal();
            _ = CalcularDsosAsync();
        }
        catch
        {
            _planetas = new();
            _eventos = new();
            _tonight = null;
            _nextLocalEclipse = null;
            _nextLocalEclipseResult = null;
            _dsoVisibles = new();
            _dsoNightStartUtc = null;
            _dsoNightEndUtc = null;
            _dsoLoading = false;
        }
    }

    private void CalcularProximoEclipseLocal()
    {
        var (eclipse, result) = EphAstronomyService.FindNextVisibleEclipse(
            DateTime.UtcNow,
            _lat,
            _lon,
            _altMetros,
            yearsAhead: 2);

        _nextLocalEclipse = eclipse;
        _nextLocalEclipseResult = result;
    }

    private async Task CalcularDsosAsync()
    {
        _calcCts?.Cancel();
        _calcCts?.Dispose();
        _calcCts = new CancellationTokenSource();
        var token = _calcCts.Token;

        _dsoLoading = true;
        _dsoVisibles = new();
        _dsoNightStartUtc = null;
        _dsoNightEndUtc = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            await Task.Run(() =>
            {
                var catalog = DsoCatalog.Select(d => new EphDsoCoordinate
                {
                    Id = d.Id,
                    RaDeg = d.RaDeg,
                    DecDeg = d.DecDeg,
                    Magnitude = d.Magnitude
                }).ToList();

                var (window, visible) = EphAstronomyService.ComputeDsoVisibility(
                    _fecha,
                    _lat,
                    _lon,
                    _altMetros,
                    catalog,
                    token);

                token.ThrowIfCancellationRequested();

                var mapped = visible
                    .Select(v =>
                    {
                        var dso = DsoCatalog.FirstOrDefault(x => x.Id == v.Id);
                        return dso is null
                            ? null
                            : new DsoVisibility
                            {
                                Dso = dso,
                                IsVisibleTonight = v.IsVisibleTonight,
                                MaxAltitude = v.MaxAltitude,
                                AzimuthAtMax = v.AzimuthAtMax,
                                VisibleFrom = v.VisibleFrom,
                                VisibleUntil = v.VisibleUntil,
                                BestViewingTime = v.BestViewingTime,
                                VisibleStartPercent = v.VisibleStartPercent,
                                VisibleWidthPercent = v.VisibleWidthPercent
                            };
                    })
                    .Where(v => v is not null)
                    .Cast<DsoVisibility>()
                    .ToList();

                InvokeAsync(() =>
                {
                    if (!IsCurrentCalc(token))
                    {
                        return;
                    }

                    _dsoNightStartUtc = window?.StartUtc;
                    _dsoNightEndUtc = window?.EndUtc;
                    _dsoVisibles = mapped;
                    StateHasChanged();
                });
            }, token);
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            if (IsCurrentCalc(token))
            {
                _dsoLoading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private bool IsCurrentCalc(CancellationToken token)
        => _calcCts is not null && _calcCts.Token == token;


    private void OnDsoImageError(DsoVisibility item)
    {
        item.ThumbnailFailed = true;
        StateHasChanged();
    }

    private IReadOnlyList<DsoEntry> DsoCatalog => DsoCatalogProvider.Catalog;
}
