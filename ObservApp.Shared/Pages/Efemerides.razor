    private static string GetFilterSvgKey(DsoFilterOption item)
    {
        if (item.AvatarClass.Contains("catalog"))
        {
            return string.IsNullOrEmpty(item.Value) ? "catalog-all" : $"catalog-{item.Value}";
        }

        if (item.AvatarClass.Contains("constellation"))
        {
            return string.IsNullOrEmpty(item.Value)
                ? "constellation"   // item "Todos"
                : $"constellation-{item.Value}";
        }

        if (item.AvatarClass.Contains("instrument"))
        {
            return item.Value switch
            {
                "NakedEye" => "instr-naked",
                "Binoculars" => "instr-bino",
                "SmallTelescope" => "instr-small",
                "MediumTelescope" => "instr-medium",
                "LargeTelescope" => "instr-large",
                _ => "instr-small"
            };
        }

        if (item.AvatarClass.Contains("sky"))
        {
            return item.Value switch
            {
                "Urban" => "sky-urban",
                "Suburban" => "sky-suburban",
                "Suburban/DarkSky" => "sky-suburbandark",
                "DarkSky" => "sky-dark",
                _ => "sky-dark"
            };
        }
        return "catalog-all";
    }

    private RenderFragment RenderFilterItem(DsoFilterOption item) => builder =>
    {
        var svgKey = GetFilterSvgKey(item);
        var svgContent = _filterSvgIcons.GetValueOrDefault(svgKey, _filterSvgIcons["catalog-all"]);

        // Contenedor item
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "eph-dso-cb-item");
        builder.AddAttribute(2, "style", "display:flex;align-items:center;gap:12px;padding:4px 2px;min-height:44px;");

        // Avatar
        builder.OpenElement(3, "span");
        builder.AddAttribute(4, "class", $"eph-dso-cb-avatar {item.AvatarClass}");
        builder.AddAttribute(5, "style", $"width:36px;height:36px;border-radius:8px;display:flex;align-items:center;justify-content:center;flex-shrink:0;overflow:hidden;border:1px solid rgba(255,255,255,.14);{DsoAvatarBackground(item.AvatarClass)}");

        // SVG inline
        builder.OpenElement(6, "span");
        builder.AddAttribute(7, "style", "display:flex;align-items:center;justify-content:center;width:20px;height:20px;flex-shrink:0;");
        builder.AddMarkupContent(8, svgContent);
        builder.CloseElement();

        builder.CloseElement(); // avatar

        // Bloque texto
        builder.OpenElement(9, "span");
        builder.AddAttribute(10, "style", "display:flex;flex-direction:column;justify-content:center;min-width:0;");

        // Título
        builder.OpenElement(11, "span");
        builder.AddAttribute(12, "class", "eph-dso-cb-title");
        builder.AddAttribute(13, "style", "display:block;font-size:.97rem;font-weight:600;line-height:1.25;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#e2e8f0;");
        builder.AddContent(14, item.Label);
        builder.CloseElement();

        // Subtitle solo si no está vacío
        if (!string.IsNullOrWhiteSpace(item.Subtitle))
        {
            builder.OpenElement(15, "span");
            builder.AddAttribute(16, "class", "eph-dso-cb-subtitle");
            builder.AddAttribute(17, "style", "display:block;font-size:.75rem;color:#94a3b8;margin-top:1px;letter-spacing:.02em;text-transform:uppercase;");
            builder.AddContent(18, item.Subtitle);
            builder.CloseElement();
        }

        builder.CloseElement(); // texto
        builder.CloseElement(); // item
    };

    private static string DsoAvatarBackground(string avatarClass) => avatarClass switch
    {
        "eph-dso-cb-avatar--catalog" => "background:rgba(46,196,182,.12);",
        "eph-dso-cb-avatar--constellation" => "background:rgba(244,196,48,.10);",
        "eph-dso-cb-avatar--instrument" => "background:rgba(123,94,167,.14);",
        "eph-dso-cb-avatar--sky" => "background:rgba(88,119,216,.12);",
        _ => "background:rgba(255,255,255,.06);"
    };

    private sealed record DsoFilterOption(
        string Value,
        string Label,
        string Icon,
        string Subtitle,
        string AvatarClass,
        string? Badge = null);

    // ── Ciclo de vida ─────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        VM.OnStateChanged += OnVmStateChanged;
        await VM.InitializeAsync();
        Calcular();
    }

    private void OnVmStateChanged()
    {
        Calcular();
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        VM.OnStateChanged -= OnVmStateChanged;
        VM.Dispose();
        _calcCts?.Cancel();
        _calcCts?.Dispose();
    }

    // ── Handlers de ubicación ─────────────────────────────────────────────────
    private async Task OnFavLocationSelected(string val)
    {
        await VM.SelectLocationAsync(val);
    }

    private async Task OnUsarGpsAsync()
    {
        await VM.UseGpsAsync();
    }

    private void OnFechaChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var d))
        {
            _fecha = d;
            Calcular();
        }
    }

    private void OnLatChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out var v))
        {
            _lat = Math.Clamp(v, -90, 90);
            VM.SetManualLocation(_lat, _lon, _altMetros);
            Calcular();
        }
    }

    private void OnLonChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out var v))
        {
            _lon = Math.Clamp(v, -180, 180);
            VM.SetManualLocation(_lat, _lon, _altMetros);
            Calcular();
        }
    }

    private void OnAltChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, out var v))
        {
            _altMetros = v;
            VM.SetManualLocation(_lat, _lon, _altMetros);
            Calcular();
        }
    }

    // ── Motor de cálculo ─────────────────────────────────────────────────────
    private void Calcular()
    {
        try
        {
            var computation = EphAstronomyService.Compute(_fecha, _lat, _lon, _altMetros);
            _planetas = computation.Planets
                .Select(p => new PlanetData
                {
                    Name = p.Name,
                    Emoji = p.Emoji,
                    Body = p.Body,
                    IsVisible = p.IsVisible,
                    MaxAltitude = p.MaxAltitude,
                    AzimuthAtMax = p.AzimuthAtMax,
                    RiseTime = p.RiseTime,
                    SetTime = p.SetTime,
                    DistanceAU = p.DistanceAU,
                    IlluminationPct = p.IlluminationPct
                })
                .ToList();

            _eventos = computation.Events
                .Select(e => new EphEvent { Emoji = e.Emoji, Date = e.Date, Description = e.Description })
                .ToList();

            _tonight = computation.Tonight is null
                ? null
                : new TonightData
                {
                    MoonIlluminationPct = computation.Tonight.MoonIlluminationPct,
                    MoonPhaseName = EfemeridesUiFormatter.MoonPhaseName(L, computation.Tonight.MoonPhaseAngle),
                    MoonPhaseEmoji = EfemeridesUiFormatter.MoonPhaseEmoji(computation.Tonight.MoonPhaseAngle),
                    AstroNightStart = computation.Tonight.AstroNightStart,
                    MoonRise = computation.Tonight.MoonRise,
                    MoonSet = computation.Tonight.MoonSet,
                    Quality = computation.Tonight.Quality switch
                    {
                        EphNightQuality.Good => NightQuality.Good,
                        EphNightQuality.Fair => NightQuality.Fair,
                        _ => NightQuality.Poor
                    }
                };

            CalcularProximoEclipseLocal();
            _ = CalcularDsosAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex,
                "Error calculando efemérides para fecha={Fecha}, lat={Lat}, lon={Lon}, alt={Alt}",
                _fecha, _lat, _lon, _altMetros);

            _planetas = new();
            _eventos = new();
            _tonight = null;
            _nextLocalEclipse = null;
            _nextLocalEclipseResult = null;
            _dsoVisibles = new();
            _dsoNightStartUtc = null;
            _dsoNightEndUtc = null;
            _dsoLoading = false;
        }
    }

    private void CalcularProximoEclipseLocal()
    {
        var (eclipse, result) = EphAstronomyService.FindNextVisibleEclipse(
            DateTime.UtcNow,
            _lat,
            _lon,
            _altMetros,
            yearsAhead: 2);

        _nextLocalEclipse = eclipse;
        _nextLocalEclipseResult = result;
    }

    private async Task CalcularDsosAsync()
    {
        _calcCts?.Cancel();
        _calcCts?.Dispose();
        _calcCts = new CancellationTokenSource();
        var token = _calcCts.Token;

        _dsoLoading = true;
        _dsoVisibles = new();
        _dsoNightStartUtc = null;
        _dsoNightEndUtc = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            await Task.Run(() =>
            {
                var catalog = DsoCatalog.Select(d => new EphDsoCoordinate
                {
                    Id = d.Id,
                    RaDeg = d.RaDeg,
                    DecDeg = d.DecDeg,
                    Magnitude = d.Magnitude
                }).ToList();

                var (window, visible) = EphAstronomyService.ComputeDsoVisibility(
                    _fecha,
                    _lat,
                    _lon,
                    _altMetros,
                    catalog,
                    token);

                token.ThrowIfCancellationRequested();

                var mapped = visible
                    .Select(v =>
                    {
                        var dso = DsoCatalog.FirstOrDefault(x => x.Id == v.Id);
                        return dso is null
                            ? null
                            : new DsoVisibility
                            {
                                Dso = dso,
                                IsVisibleTonight = v.IsVisibleTonight,
                                MaxAltitude = v.MaxAltitude,
                                AzimuthAtMax = v.AzimuthAtMax,
                                VisibleFrom = v.VisibleFrom,
                                VisibleUntil = v.VisibleUntil,
                                BestViewingTime = v.BestViewingTime,
                                VisibleStartPercent = v.VisibleStartPercent,
                                VisibleWidthPercent = v.VisibleWidthPercent
                            };
                    })
                    .Where(v => v is not null)
                    .Cast<DsoVisibility>()
                    .ToList();

                InvokeAsync(() =>
                {
                    if (!IsCurrentCalc(token))
                    {
                        return;
                    }

                    _dsoNightStartUtc = window?.StartUtc;
                    _dsoNightEndUtc = window?.EndUtc;
                    _dsoVisibles = mapped;
                    StateHasChanged();
                });
            }, token);
        }
        catch (OperationCanceledException)
        {
            // Operación cancelada normalmente (ej: usuario navegó/recargó la página)
            // No es necesario hacer nada - es el comportamiento esperado
        }
        finally
        {
            if (IsCurrentCalc(token))
            {
                _dsoLoading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private bool IsCurrentCalc(CancellationToken token)
        => _calcCts is not null && _calcCts.Token == token;


    private void OnDsoImageError(DsoVisibility item)
    {
        item.ThumbnailFailed = true;
        StateHasChanged();
    }

    private IReadOnlyList<DsoEntry> DsoCatalog => DsoCatalogProvider.Catalog;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("setupComboBoxClickHandlers", 
                    new[] { "eph-dso-catalog", "eph-dso-constellation", "eph-dso-instrument", "eph-dso-sky" });
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error setting up combo box handlers: {ex.Message}");
            }
        }
        await base.OnAfterRenderAsync(firstRender);
    }
