@page "/efemerides"
@using CosineKitty
@using System.Globalization
@using ObservApp.Shared.Models
@using ObservApp.Shared.Formatters
@using ObservApp.Shared.Models.PageModels
@using ObservApp.Shared.Services
@using ObservApp.Shared.ViewModels
@using Syncfusion.Blazor.DropDowns
@implements IDisposable
@inject IStringLocalizer<ObservApp.Resources.Strings.App> L
@inject IEfemeridesAstronomyService EphAstronomyService
@inject IDsoCatalogProvider DsoCatalogProvider
@inject IFilterSvgIconProvider SvgIcons
@inject EfemeridesViewModel VM
@inject IJSRuntime JS
@inject ILogger<Efemerides> Logger

<PageTitle>@L["Eph_Title"] — ObservApp</PageTitle>

<div class="eph-page">

    <!-- Cabecera -->
    <div class="eph-header-back">
        <a class="eph-back" href="/">← @L["Action_Back"]</a>
    </div>
    <div class="eph-header">
        <span class="eph-header-icon" aria-hidden="true">🔭</span>
        <div>
            <h1 class="eph-header-title">@L["Eph_Title"]</h1>
            <p class="eph-header-subtitle">@L["Eph_Subtitle"]</p>
        </div>
    </div>

    <!-- Inputs: Fecha y Ubicación -->
    <div class="eph-inputs-grid">

        <!-- Fecha -->
        <div class="eph-card">
            <div class="eph-card-header">
                <span class="eph-card-icon" aria-hidden="true">📅</span>
                <span class="eph-card-title">@L["Eph_Date"]</span>
            </div>
            <div class="eph-card-body">
                <input class="eph-input" type="date"
                       value="@_fecha.ToString("yyyy-MM-dd")"
                       min="1901-01-01" max="2099-12-31"
                       @onchange="OnFechaChanged" />
            </div>
        </div>

        <!-- Ubicación -->
        <LocationPicker CssPrefix="eph"
                        TitleKey="Eph_Location"
                        GpsBtnKey="SolLuna_UseGPS"
                        Locations="_favLocations"
                        IsLoading="_gpsLoading"
                        GpsError="@_gpsError"
                        GpsSource="@_gpsSource"
                        OnGpsRequested="OnUsarGpsAsync"
                        OnFavoriteSelected="OnFavLocationSelected">
            <div class="eph-card-body eph-location-body">
                <div class="eph-field">
                    <label class="eph-label">@L["SolLuna_Latitude"]</label>
                    <input class="eph-input" type="number" min="-90" max="90" step="0.0001"
                           value="@_lat.ToString(CultureInfo.InvariantCulture)"
                           @onchange="OnLatChanged" />
                </div>
                <div class="eph-field">
                    <label class="eph-label">@L["SolLuna_Longitude"]</label>
                    <input class="eph-input" type="number" min="-180" max="180" step="0.0001"
                           value="@_lon.ToString(CultureInfo.InvariantCulture)"
                           @onchange="OnLonChanged" />
                </div>
                <div class="eph-field">
                    <label class="eph-label">@L["SolLuna_Altitude"] (m)</label>
                    <input class="eph-input" type="number" min="-500" max="8900" step="1"
                           value="@_altMetros.ToString(CultureInfo.InvariantCulture)"
                           @onchange="OnAltChanged" />
                </div>
            </div>
        </LocationPicker>

    </div>

    <EclipseBanner NextEclipse="_nextLocalEclipse" NextEclipseResult="_nextLocalEclipseResult" />

    <PlanetsSection Planetas="_planetas" />

    <EventsSection Eventos="_eventos" />

    <TonightSection Tonight="_tonight" />

    @{
        // Se evalúa una única vez por render y se reutiliza tanto para el
        // contador de la cabecera como para la lista, en vez de recorrer
        // _dsoVisibles dos veces con el mismo filtro.
        var dsoFiltered = DsoFiltered.ToList();
    }
    <div class="eph-card eph-card--full eph-section">
        <div class="eph-card-header eph-dso-header">
            <span class="eph-card-icon" aria-hidden="true">🌌</span>
            <div class="eph-dso-header-text">
                <span class="eph-card-title">@L["Eph_DSO_Title"]</span>
                <span class="eph-dso-header-subtitle">@L["Eph_DSO_Subtitle"]</span>
            </div>
            @if (_dsoVisibles.Count > 0)
            {
                <span class="eph-dso-count">@dsoFiltered.Count @L["Eph_DSO_Filter_ResultCount"]</span>
            }
        </div>

        <!-- Filtros DSO -->
        <div class="eph-dso-filters">
            <input class="eph-input eph-dso-filter-search"
                   type="search"
                   placeholder="@L["Eph_DSO_Filter_Search"]"
                   aria-label="@L["Eph_DSO_Filter_Search"]"
                   value="@_dsoFilterSearch"
                   @onchange="OnDsoSearchChanged" />

            <SfComboBox Id="eph-dso-catalog" @ref="_catalogCombo"
                        CssClass="eph-dso-combo"
                        TValue="string"
                        TItem="DsoFilterOption"
                        DataSource="@DsoCatalogOptions"
                        Placeholder="@L["Eph_DSO_Filter_Catalog"]"
                        @bind-Value="_dsoFilterCatalog"
                        AllowFiltering="true"
                        AllowCustom="false"
                        PopupHeight="280px">
                <ComboBoxFieldSettings Text="Label" Value="Value" />
                <ComboBoxTemplates TItem="DsoFilterOption">
                    <ItemTemplate Context="item">
                        <DsoFilterItem AvatarClass="@item.AvatarClass" Label="@item.Label" Subtitle="@item.Subtitle" SvgContent="@SvgIcons.GetIcon(GetFilterSvgKey(item))" />
                    </ItemTemplate>
                </ComboBoxTemplates>
            </SfComboBox>

            <SfComboBox Id="eph-dso-constellation" @ref="_constellationCombo"
                        CssClass="eph-dso-combo"
                        TValue="string"
                        TItem="DsoFilterOption"
                        DataSource="@DsoConstellationOptions"
                        Placeholder="@L["Eph_DSO_Filter_Constellation"]"
                        @bind-Value="_dsoFilterConstellation"
                        AllowFiltering="true"
                        AllowCustom="false"
                        PopupHeight="280px">
                <ComboBoxFieldSettings Text="Label" Value="Value" />
                <ComboBoxTemplates TItem="DsoFilterOption">
                    <ItemTemplate Context="item">
                        <DsoFilterItem AvatarClass="@item.AvatarClass" Label="@item.Label" Subtitle="@item.Subtitle" SvgContent="@SvgIcons.GetIcon(GetFilterSvgKey(item))" />
                    </ItemTemplate>
                </ComboBoxTemplates>
            </SfComboBox>

            <SfComboBox Id="eph-dso-instrument" @ref="_instrumentCombo"
                        CssClass="eph-dso-combo"
                        TValue="string"
                        TItem="DsoFilterOption"
                        DataSource="@DsoInstrumentOptions"
                        Placeholder="@L["Eph_DSO_Filter_Instrument"]"
                        @bind-Value="_dsoFilterInstrument"
                        AllowFiltering="true"
                        AllowCustom="false"
                        PopupHeight="280px">
                <ComboBoxFieldSettings Text="Label" Value="Value" />
                <ComboBoxTemplates TItem="DsoFilterOption">
                    <ItemTemplate Context="item">
                        <DsoFilterItem AvatarClass="@item.AvatarClass" Label="@item.Label" Subtitle="@item.Subtitle" SvgContent="@SvgIcons.GetIcon(GetFilterSvgKey(item))" />
                    </ItemTemplate>
                </ComboBoxTemplates>
            </SfComboBox>

            <SfComboBox Id="eph-dso-sky" @ref="_skyCombo"
                        CssClass="eph-dso-combo"
                        TValue="string"
                        TItem="DsoFilterOption"
                        DataSource="@DsoSkyOptions"
                        Placeholder="@L["Eph_DSO_Filter_Sky"]"
                        @bind-Value="_dsoFilterSky"
                        AllowFiltering="true"
                        AllowCustom="false"
                        PopupHeight="280px">
                <ComboBoxFieldSettings Text="Label" Value="Value" />
                <ComboBoxTemplates TItem="DsoFilterOption">
                    <ItemTemplate Context="item">
                        <DsoFilterItem AvatarClass="@item.AvatarClass" Label="@item.Label" Subtitle="@item.Subtitle" SvgContent="@SvgIcons.GetIcon(GetFilterSvgKey(item))" />
                    </ItemTemplate>
                </ComboBoxTemplates>
            </SfComboBox>
        </div>

        @if (_dsoLoading)
        {
            <div class="eph-card-body eph-dso-loading-wrap">
                <SfSpinner CssClass="eph-dso-spinner" Label="@L["Eph_DSO_Loading"]" Visible="true" />
                <div class="eph-dso-loading-text">@L["Eph_DSO_Loading"]</div>
            </div>
        }
        else if (_dsoVisibles.Count == 0)
        {
            <div class="eph-empty">@L["Eph_DSO_Empty"]</div>
        }
        else
        {
            @if (dsoFiltered.Count == 0)
            {
                <div class="eph-empty">@L["Eph_DSO_Filter_NoResults"]</div>
            }
            else
            {
            <div class="eph-dso-list">
                @foreach (var item in dsoFiltered)
                {
                    <div class="eph-dso-card @EfemeridesUiFormatter.DsoAccentClass(item.Dso.Type)" @key="item.Dso.Id">
                        <div class="eph-dso-media-layout">
                            <div class="eph-dso-thumb-wrap">
                                @if (item.ThumbnailFailed)
                                {
                                    <div class="eph-dso-thumb-fallback" role="img" aria-label="@EfemeridesUiFormatter.DsoThumbnailAltText(item.Dso)">
                                        <span class="eph-dso-thumb-fallback-emoji">@item.Dso.Emoji</span>
                                        <span class="eph-dso-thumb-fallback-id">@item.Dso.Id</span>
                                    </div>
                                }
                                else
                                {
                                    <img class="eph-dso-thumb"
                                         src="@EfemeridesUiFormatter.BuildDsoThumbnailUrl(item.Dso)"
                                         alt="@EfemeridesUiFormatter.DsoThumbnailAltText(item.Dso)"
                                         loading="lazy"
                                         referrerpolicy="no-referrer"
                                         @onerror="() => OnDsoImageError(item)" />
                                }
                            </div>

                            <div class="eph-dso-main">
                                <div class="eph-dso-card-top">
                                    <div class="eph-dso-title-wrap">
                                        <span class="eph-dso-emoji">@item.Dso.Emoji</span>
                                        <div>
                                            <div class="eph-dso-name-line">
                                                <span class="eph-dso-id">@item.Dso.Id</span>
                                                <span class="eph-dso-name">@item.Dso.Name</span>
                                            </div>
                                            <div class="eph-dso-constellation">@L["Eph_DSO_Constellation"]: @item.Dso.Constellation</div>
                                        </div>
                                    </div>
                                    <div class="eph-dso-type-line">@EfemeridesUiFormatter.DsoTypeLabel(L, item.Dso.Type) · @L["Eph_DSO_Magnitude"] @item.Dso.Magnitude.ToString("F1", CultureInfo.InvariantCulture)</div>
                                </div>

                                <!-- Catálogos y nombres alternativos -->
                                @if ((item.Dso.Catalogs?.Any() ?? false) || (item.Dso.AltNames?.Any() ?? false))
                                {
                                    <div class="eph-dso-metadata-section">
                                        @if (item.Dso.Catalogs?.Any() ?? false)
                                        {
                                            <div class="eph-dso-field">
                                                <span class="eph-dso-field-label"><span aria-hidden="true">📋</span> @L["Eph_DSO_Filter_Catalog"]</span>
                                                <div class="eph-dso-badge-list">
                                                    @foreach (var cat in item.Dso.Catalogs)
                                                    {
                                                        <span class="eph-dso-badge">@cat</span>
                                                    }
                                                </div>
                                            </div>
                                        }
                                        @if (item.Dso.AltNames?.Any() ?? false)
                                        {
                                            <div class="eph-dso-field">
                                                <span class="eph-dso-field-label"><span aria-hidden="true">🏷️</span> @L["Eph_DSO_Filter_All"]</span>
                                                <div class="eph-dso-alt-names">
                                                    @foreach (var altName in item.Dso.AltNames)
                                                    {
                                                        <span class="eph-dso-altname">@altName</span>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }

                                <div class="eph-dso-stats-grid">
                                    <div class="stat-row">
                                        <span class="stat-label">@L["Eph_DSO_MaxAlt"]</span>
                                        <span class="stat-value">@item.MaxAltitude.ToString("F1", CultureInfo.InvariantCulture)°</span>
                                    </div>
                                    <div class="stat-row">
                                        <span class="stat-label">@L["Eph_DSO_BestTime"]</span>
                                        @EfemeridesUiFormatter.FormatTimeOpt(item.BestViewingTime)
                                    </div>
                                    <div class="stat-row">
                                        <span class="stat-label">@L["Eph_DSO_VisibleFrom"]</span>
                                        @EfemeridesUiFormatter.FormatTimeOpt(item.VisibleFrom)
                                    </div>
                                    <div class="stat-row">
                                        <span class="stat-label">@L["Eph_DSO_VisibleTo"]</span>
                                        @EfemeridesUiFormatter.FormatTimeOpt(item.VisibleUntil)
                                    </div>
                                </div>

                                <!-- Instrumento y Calidad del cielo -->
                                @if (!string.IsNullOrEmpty(item.Dso.RecommendedInstrument) || !string.IsNullOrEmpty(item.Dso.SkyRequirement))
                                {
                                    <div class="eph-dso-observation-reqs">
                                        @if (!string.IsNullOrEmpty(item.Dso.RecommendedInstrument))
                                        {
                                            <div class="eph-dso-req-item">
                                                <span class="eph-dso-req-icon" aria-hidden="true">🔭</span>
                                                <div>
                                                    <div class="eph-dso-req-label">@L["Eph_DSO_Filter_Instrument"]</div>
                                                    <div class="eph-dso-req-value">@item.Dso.RecommendedInstrument</div>
                                                </div>
                                            </div>
                                        }
                                        @if (!string.IsNullOrEmpty(item.Dso.SkyRequirement))
                                        {
                                            <div class="eph-dso-req-item">
                                                <span class="eph-dso-req-icon" aria-hidden="true">🌌</span>
                                                <div>
                                                    <div class="eph-dso-req-label">@L["Eph_DSO_Filter_Sky"]</div>
                                                    <div class="eph-dso-req-value">@item.Dso.SkyRequirement</div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }

                                <!-- Mejores meses -->
                                @if (item.Dso.BestMonths?.Any() ?? false)
                                {
                                    <div class="eph-dso-months-section">
                                        <span class="eph-dso-months-label"><span aria-hidden="true">📅</span> @L["Eph_DSO_BestMonths"]</span>
                                        <div class="eph-dso-months-grid">
                                            @foreach (var month in item.Dso.BestMonths)
                                            {
                                                <span class="eph-dso-month-badge">@month</span>
                                            }
                                        </div>
                                    </div>
                                }

                                <div class="eph-dso-track-wrap">
                                    <div class="eph-dso-track-labels">
                                        @EfemeridesUiFormatter.FormatTimeOpt(_dsoNightStartUtc)
                                        @EfemeridesUiFormatter.FormatTimeOpt(_dsoNightEndUtc)
                                    </div>
                                    <div class="eph-dso-track">
                                        <div class="eph-dso-track-visible" style="@EfemeridesUiFormatter.BuildDsoVisibilityStyle(item)"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
            }
        }
    </div>

</div>

@code {

    // ── Estado ────────────────────────────────────────────────────────────────
    private DateTime _fecha
    {
        get => VM.Fecha;
        set => VM.Fecha = value;
    }

    private double _lat
    {
        get => VM.Latitude;
        set => VM.Latitude = value;
    }

    private double _lon
    {
        get => VM.Longitude;
        set => VM.Longitude = value;
    }

    private double _altMetros
    {
        get => VM.AltitudeMeters;
        set => VM.AltitudeMeters = value;
    }

    private IReadOnlyList<FavoriteLocation> _favLocations => VM.FavoriteLocations;
    private bool _gpsLoading => VM.GpsLoading;
    private string? _gpsError => VM.GpsError;
    private string? _gpsSource => VM.GpsSource;

    private List<PlanetData> _planetas = new();
    private List<EphEvent> _eventos = new();
    private TonightData? _tonight;
    private EclipseDefinition? _nextLocalEclipse;
    private LocalEclipseResult? _nextLocalEclipseResult;
    private List<DsoVisibility> _dsoVisibles = new();
    private bool _dsoLoading;
    private DateTime? _dsoNightStartUtc;
    private DateTime? _dsoNightEndUtc;
    private CancellationTokenSource? _calcCts;

    // ── Filtros DSO ──────────────────────────────────────────────────────────
    private string _dsoFilterSearch = string.Empty;
    private string _dsoFilterCatalog = string.Empty;
    private string _dsoFilterConstellation = string.Empty;
    private string _dsoFilterInstrument = string.Empty;
    private string _dsoFilterSky = string.Empty;

    // Referencias a los SfComboBox para abrir el popup con foco
    private SfComboBox<string, DsoFilterOption>? _catalogCombo;
    private SfComboBox<string, DsoFilterOption>? _constellationCombo;
    private SfComboBox<string, DsoFilterOption>? _instrumentCombo;
    private SfComboBox<string, DsoFilterOption>? _skyCombo;

    private IEnumerable<DsoVisibility> DsoFiltered => _dsoVisibles.Where(item =>
        (string.IsNullOrEmpty(_dsoFilterSearch) || DsoMatchesSearch(item.Dso, _dsoFilterSearch)) &&
        (string.IsNullOrEmpty(_dsoFilterCatalog) || GetDsoCatalogPrefix(item.Dso) == _dsoFilterCatalog) &&
        (string.IsNullOrEmpty(_dsoFilterConstellation) || item.Dso.Constellation == _dsoFilterConstellation) &&
        (string.IsNullOrEmpty(_dsoFilterInstrument) || GetDsoInstrumentCategory(item.Dso.RecommendedInstrument) == _dsoFilterInstrument) &&
        (string.IsNullOrEmpty(_dsoFilterSky) || item.Dso.SkyRequirement == _dsoFilterSky));

    private IEnumerable<DsoFilterOption> DsoCatalogOptions =>
    [
        new(string.Empty, $"{L["Eph_DSO_Filter_Catalog"]} — {L["Eph_DSO_Filter_All"]}", string.Empty, string.Empty, "eph-dso-cb-avatar--catalog"),
        .. DsoCatalog
            .SelectMany(d => d.Catalogs ?? [])
            .Select(GetCatalogEntryPrefix)
            .Where(p => !string.IsNullOrEmpty(p))
            .Distinct()
            .OrderBy(p => p)
            .Select(prefix => new DsoFilterOption(
                prefix,
                DsoCatalogLabel(prefix),
                string.Empty,
                string.Empty,        // L["Eph_DSO_Filter_Catalog"]
                "eph-dso-cb-avatar--catalog",
                DsoCatalogLabel(prefix)[0].ToString()))
    ];

    private IEnumerable<DsoFilterOption> DsoConstellationOptions =>
    [
        new(string.Empty, $"{L["Eph_DSO_Filter_Constellation"]} — {L["Eph_DSO_Filter_All"]}", string.Empty, string.Empty, "eph-dso-cb-avatar--constellation"),
        .. DsoCatalog
            .Select(d => d.Constellation)
            .Where(c => !string.IsNullOrEmpty(c))
            .Distinct()
            .OrderBy(c => c)
            .Select(c => new DsoFilterOption(c, c, string.Empty, string.Empty, "eph-dso-cb-avatar--constellation"))
    ];

    private IEnumerable<DsoFilterOption> DsoInstrumentOptions =>
    [
        new(string.Empty, $"{L["Eph_DSO_Filter_Instrument"]} — {L["Eph_DSO_Filter_All"]}", string.Empty, string.Empty, "eph-dso-cb-avatar--instrument"),
        .. DsoCatalog
            .Select(d => GetDsoInstrumentCategory(d.RecommendedInstrument))
            .Where(i => !string.IsNullOrEmpty(i))
            .Distinct()
            .OrderBy(i => i)
            .Select(i => new DsoFilterOption(i, DsoInstrumentLabel(i), DsoInstrumentIcon(i), string.Empty, "eph-dso-cb-avatar--instrument"))
    ];

    private IEnumerable<DsoFilterOption> DsoSkyOptions =>
    [
        new(string.Empty, $"{L["Eph_DSO_Filter_Sky"]} — {L["Eph_DSO_Filter_All"]}", string.Empty, string.Empty, "eph-dso-cb-avatar--sky"),
        .. DsoCatalog
            .Select(d => d.SkyRequirement ?? string.Empty)
            .Where(s => !string.IsNullOrEmpty(s))
            .Distinct()
            .OrderBy(s => s)
            .Select(s => new DsoFilterOption(s, DsoSkyLabel(s), DsoSkyIcon(s), string.Empty, "eph-dso-cb-avatar--sky"))
    ];

    private static readonly Dictionary<string, string> CatalogPrefixMap = new(StringComparer.OrdinalIgnoreCase)
    {
        { "M",   "Messier"   },
        { "C",   "Caldwell"  },
        { "NGC", "NGC"       },
        { "IC",  "IC"        },
        { "Cr",  "Collinder" },
        { "Mel", "Melotte"   },
        { "B",   "Barnard"   },
    };

    private static string GetCatalogEntryPrefix(string entry)
    {
        if (string.IsNullOrWhiteSpace(entry)) return string.Empty;
        var trimmed = entry.TrimStart();
        foreach (var key in CatalogPrefixMap.Keys.OrderByDescending(k => k.Length))
        {
            if (trimmed.StartsWith(key, StringComparison.OrdinalIgnoreCase)
                && (trimmed.Length == key.Length || !char.IsLetter(trimmed[key.Length])))
                return key;
        }
        return string.Empty;
    }

    private static string GetDsoCatalogPrefix(DsoEntry dso)
    {
        foreach (var cat in dso.Catalogs ?? [])
        {
            var prefix = GetCatalogEntryPrefix(cat);
            if (!string.IsNullOrEmpty(prefix)) return prefix;
        }
        return string.Empty;
    }

    private static string GetDsoInstrumentCategory(string? raw)
    {
        if (string.IsNullOrEmpty(raw)) return string.Empty;
        if (raw.Contains("Naked eye", StringComparison.OrdinalIgnoreCase)) return "NakedEye";
        if (raw.StartsWith("Binoculars", StringComparison.OrdinalIgnoreCase)) return "Binoculars";
        if (raw.StartsWith("Small", StringComparison.OrdinalIgnoreCase)) return "SmallTelescope";
        if (raw.Contains("Medium to large", StringComparison.OrdinalIgnoreCase)) return "LargeTelescope";
        if (raw.StartsWith("Medium", StringComparison.OrdinalIgnoreCase)) return "MediumTelescope";
        return string.Empty;
    }

    private static bool DsoMatchesSearch(DsoEntry dso, string search)
    {
        var s = search.Trim();
        if (string.IsNullOrEmpty(s)) return true;
        if (dso.Id.Contains(s, StringComparison.OrdinalIgnoreCase)) return true;
        if (dso.Name.Contains(s, StringComparison.OrdinalIgnoreCase)) return true;
        if (dso.AltNames is not null && dso.AltNames.Any(n => n.Contains(s, StringComparison.OrdinalIgnoreCase))) return true;
        if (dso.Catalogs is not null && dso.Catalogs.Any(c => c.Contains(s, StringComparison.OrdinalIgnoreCase))) return true;
        return false;
    }

    private string DsoCatalogLabel(string prefix) => prefix switch
    {
        "M"   => L["Eph_DSO_Cat_Messier"],
        "C"   => L["Eph_DSO_Cat_Caldwell"],
        "NGC" => L["Eph_DSO_Cat_NGC"],
        "IC"  => L["Eph_DSO_Cat_IC"],
        "Cr"  => L["Eph_DSO_Cat_Collinder"],
        "Mel" => L["Eph_DSO_Cat_Melotte"],
        "B"   => L["Eph_DSO_Cat_Barnard"],
        _     => prefix
    };

    private string DsoInstrumentLabel(string key) => key switch
    {
        "NakedEye"        => L["Eph_DSO_Instr_NakedEye"],
        "Binoculars"      => L["Eph_DSO_Instr_Binoculars"],
        "SmallTelescope"  => L["Eph_DSO_Instr_SmallTelescope"],
        "MediumTelescope" => L["Eph_DSO_Instr_MediumTelescope"],
        "LargeTelescope"  => L["Eph_DSO_Instr_LargeTelescope"],
        _                 => key
    };

    private string DsoSkyLabel(string key) => key switch
    {
        "Urban"            => L["Eph_DSO_Sky_Urban"],
        "Suburban"         => L["Eph_DSO_Sky_Suburban"],
        "Suburban/DarkSky" => L["Eph_DSO_Sky_SuburbanDarkSky"],
        "DarkSky"          => L["Eph_DSO_Sky_DarkSky"],
        _                  => key
    };
       

    private static string DsoInstrumentIcon(string key) => key switch
    {
        "NakedEye" => "👁️",
        "Binoculars" => "🥽",
        "SmallTelescope" => "🔭",
        "MediumTelescope" => "🛰️",
        "LargeTelescope" => "📡",
        _ => "🎚️"
    };

    private static string DsoSkyIcon(string key) => key switch
    {
        "Urban" => "🌆",
        "Suburban" => "🏘️",
        "Suburban/DarkSky" => "🌗",
        "DarkSky" => "🌌",
        _ => "🌘"
    };

    private void OnDsoSearchChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        _dsoFilterSearch = e.Value?.ToString() ?? string.Empty;
        StateHasChanged();
    }
    private static string GetFilterSvgKey(DsoFilterOption item)
    {
        if (item.AvatarClass.Contains("catalog"))
        {
            return string.IsNullOrEmpty(item.Value) ? "catalog-all" : $"catalog-{item.Value}";
        }

        if (item.AvatarClass.Contains("constellation"))
        {
            return string.IsNullOrEmpty(item.Value)
                ? "constellation"   // item "Todos"
                : $"constellation-{item.Value}";
        }

        if (item.AvatarClass.Contains("instrument"))
        {
            return item.Value switch
            {
                "NakedEye" => "instr-naked",
                "Binoculars" => "instr-bino",
                "SmallTelescope" => "instr-small",
                "MediumTelescope" => "instr-medium",
                "LargeTelescope" => "instr-large",
                _ => "instr-small"
            };
        }

        if (item.AvatarClass.Contains("sky"))
        {
            return item.Value switch
            {
                "Urban" => "sky-urban",
                "Suburban" => "sky-suburban",
                "Suburban/DarkSky" => "sky-suburbandark",
                "DarkSky" => "sky-dark",
                _ => "sky-dark"
            };
        }
        return "catalog-all";
    }


