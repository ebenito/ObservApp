    private static readonly string[] DsoConstellationFallbackIcons = ["⭐", "🌟", "✦", "✶", "✷", "✸", "✹", "✺"];

    private static string DsoConstellationIcon(string constellation)
    {
        var known = constellation switch
        {
            "Orion" => "🏹",
            "Leo" => "🦁",
            "Ursa Major" => "🐻",
            "Scorpius" => "🦂",
            "Sagittarius" => "♐",
            "Cassiopeia" => "👑",
            "Cygnus" => "🦢",
            "Lyra" => "🎼",
            "Gemini" => "♊",
            "Cancer" => "♋",
            "Taurus" => "♉",
            "Aquarius" => "♒",
            "Pisces" => "♓",
            "Capricornus" => "♑",
            "Aries" => "♈",
            "Virgo" => "♍",
            "Libra" => "♎",
            _ => string.Empty
        };

        if (!string.IsNullOrEmpty(known))
        {
            return known;
        }

        var idx = Math.Abs(constellation.GetHashCode(StringComparison.OrdinalIgnoreCase)) % DsoConstellationFallbackIcons.Length;
        return DsoConstellationFallbackIcons[idx];
    }

