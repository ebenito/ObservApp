@page "/senales"
@using ObservApp.Shared.Models
@using ObservApp.Shared.Services
@implements IDisposable
@inject IStringLocalizer<ObservApp.Resources.Strings.App> L
@inject IArticleService Articles
@inject IExternalLinkService ExternalLinks
@inject ITextToSpeechService Tts
@inject ILocalizationService Localization

<PageTitle>@L["Signals_Title"] — ObservApp</PageTitle>

<div class="signals-page">

    <!-- Cabecera -->
    <div class="signals-header">
        <span class="signals-header-icon">📡</span>
        <div>
            <h1 class="signals-header-title">@L["Signals_Title"]</h1>
            <p class="signals-header-subtitle">@L["Signals_Subtitle"]</p>
        </div>
    </div>

    <!-- Filtro de idioma -->
    <div class="signals-filters">
        <button class="signals-filter-btn @(_langFilter == null ? "active" : "")"
                @onclick='() => SetLangFilter(null)'>
            🌍 @L["Signals_Filter_All"]
        </button>
        <button class="signals-filter-btn @(_langFilter == "es" ? "active" : "")"
                @onclick='() => SetLangFilter("es")'>
            🇪🇸 @L["Signals_Filter_Es"]
        </button>
        <button class="signals-filter-btn @(_langFilter == "en" ? "active" : "")"
                @onclick='() => SetLangFilter("en")'>
            🇬🇧 @L["Signals_Filter_En"]
        </button>
    </div>

    @if (_loading && _currentPage == 1)
    {
        <div class="signals-empty">
            <span class="signals-spinner"></span> @L["Status_Loading"]
        </div>
    }
    else if (_error is not null && _filteredItems.Count == 0)
    {
        <div class="signals-error">⚠️ @_error</div>
    }
    else if (_filteredItems.Count == 0)
    {
        <div class="signals-empty">@L["Status_NoData"]</div>
    }
    else
    {
        <div class="signals-list">
            @foreach (var item in _filteredItems)
            {
                <article class="signals-card">

                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <div class="signals-card-image">
                            <img src="@item.ImageUrl" alt="" loading="lazy" />
                        </div>
                    }

                    <div class="signals-card-body">

                        <div class="signals-card-meta">
                            <span class="signals-badge">@item.SourceDisplayName</span>
                            <span class="signals-date">@item.PublishedDate.ToLocalTime().ToString("d MMM yyyy")</span>
                        </div>

                        <h2 class="signals-card-title">@item.Title</h2>
                        <p class="signals-card-summary">@item.Summary</p>

                        <div class="signals-card-actions">
                            <button class="signals-btn @(IsPlaying(item) ? "signals-btn--playing" : "signals-btn--accent")"
                                    @onclick="() => ToggleListenAsync(item)">
                                @if (IsPlaying(item))
                                {
                                    <span>⏹ @L["Signals_Stop"]</span>
                                }
                                else
                                {
                                    <span>🔊 @L["Signals_Listen"]</span>
                                }
                            </button>
                            <button class="signals-btn" @onclick="() => OpenInBrowserAsync(item.SourceUrl)">
                                🌐 @L["Signals_OpenBrowser"]
                            </button>
                        </div>

                    </div>
                </article>
            }
        </div>

        <!-- Paginación -->
        <div class="signals-pagination">

            @if (_currentPage > 1)
            {
                <button class="signals-page-btn" @onclick="PrevPageAsync" disabled="@_loading">
                    ← @L["Signals_PrevPage"]
                </button>
            }
            else
            {
                <span></span>
            }

            <span class="signals-page-info">
                @L["Signals_Page"] @_currentPage
                @if (_filteredTotalCount > 0)
                {
                    <span> · @_filteredTotalCount @L["Signals_Articles"]</span>
                }
            </span>

            @if (_hasNextPage)
            {
                <button class="signals-page-btn signals-page-btn--next"
                        @onclick="NextPageAsync" disabled="@_loading">
                    @if (_loading)
                    {
                        <span class="signals-spinner"></span>
                    }
                    @L["Signals_NextPage"] →
                </button>
            }
            else
            {
                <span></span>
            }

        </div>

        @if (_error is not null)
        {
            <p class="signals-error-partial">⚠️ @L["Signals_PartialError"]<br /><small>@_error</small></p>
        }
    }

</div>

@code {
    private const int PageSize = 10;

    private List<ArticleModel> _items         = new();
    private List<ArticleModel> _filteredItems = new();
    private bool    _loading      = true;
    private string? _error;
    private int     _currentPage  = 1;
    private bool    _hasNextPage;
    private int     _totalCount   = -1;
    private int     _filteredTotalCount = -1; // Total contando el filtro de idioma

    // Filtro de idioma: null = todos, "es" = español, "en" = inglés
    private string? _langFilter = null;

    protected override async Task OnInitializedAsync()
    {
        Tts.PlaybackStateChanged += OnPlaybackStateChanged;
        await LoadPageAsync(1);
    }

    private async Task LoadPageAsync(int page)
    {
        _loading = true;
        _error   = null;
        StateHasChanged();

        try
        {
            var result = await Articles.GetPageAsync(page, PageSize);

            _items       = result.Items;
            _currentPage = result.CurrentPage;
            _hasNextPage = result.HasNextPage;
            _totalCount  = result.TotalCount;

            if (Articles.LastError is not null)
                _error = Articles.LastError;

            ApplyFilter();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplyFilter()
    {
        _filteredItems = _langFilter is null
            ? _items
            : _items.Where(a => a.LanguageCode == _langFilter).ToList();

        if (_langFilter is null)
        {
            _filteredTotalCount = _totalCount;
            return;
        }

        // Con filtro por idioma no conocemos el total real sin descargar todas las páginas.
        // Mantener -1 (desconocido) mientras el servicio indique que puede haber más.
        _filteredTotalCount = _hasNextPage ? -1 : _filteredItems.Count;
    }

    private async Task SetLangFilter(string? lang)
    {
        if (_langFilter == lang) return;
        Tts.Stop();
        _playingLink = null;
        _langFilter  = lang;
        await LoadPageAsync(1);
    }

    private async Task NextPageAsync()
    {
        Tts.Stop();
        _playingLink = null;
        await LoadPageAsync(_currentPage + 1);
    }

    private async Task PrevPageAsync()
    {
        Tts.Stop();
        _playingLink = null;
        await LoadPageAsync(_currentPage - 1);
    }

    private async Task OpenInBrowserAsync(string url)
    {
        await ExternalLinks.OpenAsync(url);
    }

    // ── TTS ───────────────────────────────────────────────────────────

    private string? _playingLink;

    private bool IsPlaying(ArticleModel item)
        => _playingLink == item.SourceUrl && Tts.IsSpeaking;

    private async Task ToggleListenAsync(ArticleModel item)
    {
        if (IsPlaying(item))
        {
            Tts.Stop();
            _playingLink = null;
            return;
        }

        _playingLink = item.SourceUrl;

        var text = $"{item.Title}. {item.Summary}";
        var lang = string.IsNullOrWhiteSpace(item.LanguageCode)
            ? Localization.CurrentLanguageCode
            : item.LanguageCode;

        await Tts.SpeakAsync(text, lang);

        if (!Tts.IsSpeaking)
            _playingLink = null;

        StateHasChanged();
    }

    private void OnPlaybackStateChanged()
    {
        if (!Tts.IsSpeaking)
            _playingLink = null;

        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Tts.PlaybackStateChanged -= OnPlaybackStateChanged;
        Tts.Stop();
    }
}
