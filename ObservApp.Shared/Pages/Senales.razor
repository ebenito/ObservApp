@page "/senales"
@using ObservApp.Shared.Services
@implements IDisposable
@inject IStringLocalizer<ObservApp.Resources.Strings.App> L
@inject IRssFeedService RssService
@inject IExternalLinkService ExternalLinks
@inject ITextToSpeechService Tts
@inject ILocalizationService Localization

<PageTitle>@L["Signals_Title"] — ObservApp</PageTitle>

<div class="signals-page">

    <!-- Cabecera -->
    <div class="signals-header">
        <span class="signals-header-icon">📡</span>
        <div>
            <h1 class="signals-header-title">@L["Signals_Title"]</h1>
            <p class="signals-header-subtitle">@L["Signals_Subtitle"]</p>
        </div>
    </div>

    @if (_loading)
    {
        <div class="signals-empty">
            <span class="signals-spinner"></span> @L["Status_Loading"]
        </div>
    }
    else if (_error is not null)
    {
        <div class="signals-error">⚠️ @_error</div>
    }
    else if (_items.Count == 0)
    {
        <div class="signals-empty">@L["Status_NoData"]</div>
    }
    else
    {
        <div class="signals-list">
            @foreach (var item in _items)
            {
                <article class="signals-card">

                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <div class="signals-card-image">
                            <img src="@item.ImageUrl" alt="" loading="lazy" />
                        </div>
                    }

                    <div class="signals-card-body">

                        <div class="signals-card-meta">
                            <span class="signals-badge">@item.SourceName</span>
                            <span class="signals-date">@item.PublishedUtc.ToLocalTime().ToString("d MMM yyyy")</span>
                        </div>

                        <h2 class="signals-card-title">@item.Title</h2>
                        <p class="signals-card-summary">@item.Summary</p>

                        <div class="signals-card-actions">
                            <button class="signals-btn @(IsPlaying(item) ? "signals-btn--playing" : "signals-btn--accent")"
                                    @onclick="() => ToggleListenAsync(item)">
                                @if (IsPlaying(item))
                                {
                                    <span>⏹ @L["Signals_Stop"]</span>
                                }
                                else
                                {
                                    <span>🔊 @L["Signals_Listen"]</span>
                                }
                            </button>
                            <button class="signals-btn" @onclick="() => OpenInBrowserAsync(item.Link)">
                                🌐 @L["Signals_OpenBrowser"]
                            </button>
                        </div>

                    </div>
                </article>
            }
        </div>
    }

</div>

@code {
    private List<RssFeedItem> _items = new();
    private bool _loading = true;
    private string? _error;

    // ── Fuente de prueba — Tubkala fijo, sin gestión de fuentes todavía ─────
    private static readonly RssSource TubkalaSource = new(
        Id: "tubkala",
        Name: "Tubkala",
        Url: "https://tubkala.com/feed/",
        IsBuiltIn: true);

    protected override async Task OnInitializedAsync()
    {
        Tts.PlaybackStateChanged += OnPlaybackStateChanged;

        try
        {
            _items = await RssService.GetItemsFromSourceAsync(TubkalaSource);

            if (_items.Count == 0)
            {
                _error = RssService.GetLastError(TubkalaSource.Id)
                         ?? L["Status_NoData"];
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenInBrowserAsync(string url)
    {
        await ExternalLinks.OpenAsync(url);
    }

    // ── TTS — lectura de artículos ────────────────────────────────────────────

    // Identificamos el artículo en reproducción por su Link (clave natural
    // del RssFeedItem; no hay Id propio).
    private string? _playingLink;

    private bool IsPlaying(RssFeedItem item)
        => _playingLink == item.Link && Tts.IsSpeaking;

    private async Task ToggleListenAsync(RssFeedItem item)
    {
        // Si ya está sonando este artículo → lo detenemos.
        if (IsPlaying(item))
        {
            Tts.Stop();
            _playingLink = null;
            return;
        }

        // Si sonaba otro artículo, SpeakAsync lo detiene internamente;
        // igualmente actualizamos aquí para reflejar el cambio sin demora.
        _playingLink = item.Link;

        var text = $"{item.Title}. {item.Summary}";
        var languageCode = string.IsNullOrWhiteSpace(item.LanguageCode)
            ? Localization.CurrentLanguageCode
            : item.LanguageCode;

        await Tts.SpeakAsync(text, languageCode);

        // Si no se pudo iniciar (sin voz para el idioma), Tts.IsSpeaking
        // queda en false — limpiamos el estado para que el botón vuelva
        // a "Escuchar" en vez de quedarse marcado como activo.
        if (!Tts.IsSpeaking)
            _playingLink = null;

        StateHasChanged();
    }

    private void OnPlaybackStateChanged()
    {
        if (!Tts.IsSpeaking)
            _playingLink = null;

        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Tts.PlaybackStateChanged -= OnPlaybackStateChanged;
        Tts.Stop();
    }
}