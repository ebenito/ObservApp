@page "/calculadoras/eclipse-solar"
@using CosineKitty
@using System.Globalization
@using ObservApp.Shared.Models
@using ObservApp.Shared.Services
@implements IDisposable
@inject IStringLocalizer<App> L
@inject IGeolocationService GeoService
@inject IFavoriteLocationsService FavLocationsService
@inject IEclipseCalculatorService EclipseCalc
@inject IEclipseAudioService AudioService
@inject CameraManager CameraManager
@inject ICameraService CameraDevice
@inject EclipseCameraProfileState CameraProfile

<PageTitle>@L["EclipseTimer_Title"] — ObservApp</PageTitle>

<div class="eclt-page">

    <!-- CABECERA -->
    <div class="eclt-header-back">
        <a class="eclt-back" href="/calculadoras">← @L["Action_Back"]</a>
    </div>
    <div class="eclt-header">
        <span class="eclt-header-icon">🌑</span>
        <div>
            <h1 class="eclt-title">@L["EclipseTimer_Title"]</h1>
            <p class="eclt-subtitle">@L["EclipseTimer_Subtitle"]</p>
        </div>
    </div>

    <!-- SELECTOR DE ECLIPSE -->
    <div class="eclt-card">
        <div class="eclt-card-header">
            <span>☀️</span> @L["EclipseTimer_SelectEclipse"]
        </div>
        <div class="eclt-card-body">
            <div class="eclt-eclipse-list">
                @foreach (var ecl in _eclipses)
                {
                    bool selected = _selectedEclipse?.Id == ecl.Id;
                    bool past = ecl.Date < DateTime.UtcNow;
                    <button class="eclt-eclipse-btn @(selected ? "selected" : "") @(past ? "past" : "")"
                            @onclick="() => SelectEclipse(ecl)">
                        <span class="eclt-eclipse-date">
                            @ecl.Date.ToLocalTime().ToString("d MMM yyyy")
                        </span>
                        <span class="eclt-eclipse-type @GetTypeCssClass(ecl.MaxType)">
                            @GetTypeLabel(ecl.MaxType)
                        </span>
                        <span class="eclt-eclipse-region">@ecl.RegionLabel</span>
                        @if (past)
                        {
                            <span class="eclt-eclipse-past-badge">@L["EclipseTimer_Warning_Past"]</span>
                        }
                    </button>
                }
            </div>
        </div>
    </div>

    <!-- SELECTOR DE UBICACIÓN -->
    <div class="eclt-card">
        <div class="eclt-card-header eclt-location-header">
            <span>📍</span> @L["EclipseTimer_Location"]
            <button class="eclt-gps-btn @(_gpsLoading ? "loading" : "")"
                    @onclick="OnUseGpsAsync" disabled="@_gpsLoading">
                @if (_gpsLoading)
                { <span class="eclt-spinner"></span> }
                else
                { <span>📡</span> }
                @L["EclipseTimer_UseGPS"]
            </button>
        </div>
        <div class="eclt-card-body">
            <!-- Selector de favoritas -->
            <select class="eclt-select" @onchange="OnFavLocationChanged">
                <option value="manual">📍 @L["FavLoc_Select_Manual"]</option>
                <option value="gps">📡 @L["FavLoc_Select_GPS"]</option>
                @if (_favLocations != null)
                {
                    @foreach (var loc in _favLocations)
                    {
                        <option value="@loc.Id">⭐ @loc.Name</option>
                    }
                }
            </select>

            @if (!string.IsNullOrEmpty(_gpsError))
            {
                <div class="eclt-error">⚠️ @_gpsError</div>
            }

            <!-- Coordenadas manuales -->
            <div class="eclt-coords-row">
                <div class="eclt-field">
                    <label class="eclt-label">@L["SolLuna_Latitude"]</label>
                    <input class="eclt-input" type="number" min="-90" max="90" step="0.0001"
                           @bind="_lat" />
                </div>
                <div class="eclt-field">
                    <label class="eclt-label">@L["SolLuna_Longitude"]</label>
                    <input class="eclt-input" type="number" min="-180" max="180" step="0.0001"
                           @bind="_lon" />
                </div>
                <div class="eclt-field">
                    <label class="eclt-label">@L["SolLuna_Altitude"] (m)</label>
                    <input class="eclt-input" type="number" @bind="_alt" />
                </div>
            </div>

            @if (_gpsSourceLabel != null)
            {
                <div class="eclt-gps-source">📡 @_gpsSourceLabel</div>
            }

            <button class="eclt-calc-btn" @onclick="CalculateEclipse"
                    disabled="@(_selectedEclipse == null)">
                @L["EclipseTimer_Calculate"]
            </button>
        </div>
    </div>

    <!-- DISPARO AUTOMÁTICO DE CÁMARA -->
    <div class="eclt-card">
        <div class="eclt-card-header">
            <span>📷</span> Disparo automático de cámara
        </div>
        <div class="eclt-card-body">

            <div class="eclt-coords-row" style="grid-template-columns: 1fr 1fr 1fr;">
                <button class="eclt-gps-btn @(_cameraConnecting ? "loading" : "")"
                        @onclick="OnConnectCameraAsync" disabled="@_cameraConnecting">
                    @if (_cameraConnecting)
                    {
                        <span class="eclt-spinner"></span>
                    }
                    else
                    {
                        <span>@(CameraDevice.IsConnected ? "✅" : "🔌")</span>
                    }
                    @(CameraDevice.IsConnected ? "Conectada" : "Conectar")
                </button>

                <div class="eclt-field">
                    <label class="eclt-label">Fotos por evento</label>
                    <input class="eclt-input" type="number" min="1" max="20" @bind="_photosPerEvent" />
                </div>

                <div class="eclt-field">
                    <label class="eclt-label">Equipo (f/ · ISO)</label>
                    <span class="eclt-input" style="display:flex;align-items:center;">
                        @(CameraProfile.IsConfigured ? $"f/{CameraProfile.ApertureFNumber:0.#} · ISO {CameraProfile.Iso}" : "—")
                    </span>
                </div>
            </div>

            @if (!CameraProfile.IsConfigured)
            {
                <div class="eclt-error">
                    ⚠️ Configura apertura/ISO en la
                    <a href="/calculadoras/eclipse" style="color:var(--obs-aurora)">Calculadora de Exposición</a>.
                </div>
            }

            @if (!string.IsNullOrEmpty(CameraDevice.LastError))
            {
                <div class="eclt-error">⚠️ @CameraDevice.LastError</div>
            }

            <label style="display:flex;align-items:center;gap:8px;margin-top:10px;cursor:pointer;">
                <input type="checkbox" @bind="_cameraAutoEnabled" disabled="@(!CameraProfile.IsConfigured)" />
                <span style="color:var(--obs-moon);font-size:0.85rem;">
                    Activar disparo automático durante este eclipse
                </span>
            </label>

            @if (_cameraStatusText is not null)
            {
                <div class="eclt-gps-source">📸 @_cameraStatusText</div>
            }

        </div>
    </div>

    <!-- RESULTADOS -->
    @if (_result != null)
    {
        @if (!_result.IsVisible || _result.Type == LocalEclipseType.None)
        {
            <div class="eclt-card eclt-card--warning">
                <div class="eclt-card-body">
                    <span class="eclt-warning-icon">🌐</span>
                    <p>@L["EclipseTimer_NotVisible"]</p>
                </div>
            </div>
        }
        else
        {
            <!-- BANNER TIPO LOCAL + MÉTRICAS -->
            <div class="eclt-type-banner eclt-type-banner--@_result.Type.ToString().ToLower()">
                <span class="eclt-type-icon">@GetLocalTypeEmoji(_result.Type)</span>
                <div class="eclt-type-info">
                    <div class="eclt-type-label">@GetLocalTypeLabel(_result.Type)</div>
                    <div class="eclt-coverage-label">
                        @L["EclipseTimer_MaxCoverage"]: @((MaxCoveragePercent * 100).ToString("F1"))%
                    </div>
                </div>
                <!-- Toggle audio -->
                <button class="eclt-audio-toggle @(_audioEnabled ? "on" : "off")"
                        @onclick="ToggleAudio">
                    @(_audioEnabled ? "🔔" : "🔕")
                    @(_audioEnabled ? L["EclipseTimer_AudioOn"] : L["EclipseTimer_AudioOff"])
                </button>
            </div>

            @if (_result.Metrics != null)
            {
                var m = _result.Metrics;
                var ic = System.Globalization.CultureInfo.InvariantCulture;

                <div class="eclt-metrics-grid">

                    <!-- Magnitud -->
                    <div class="eclt-metric-item">
                        <span class="eclt-metric-label">@L["EclipseTimer_Magnitude"]</span>
                        <span class="eclt-metric-value">@m.Magnitude.ToString("F4", ic)</span>
                    </div>

                    <!-- Gamma -->
                    <div class="eclt-metric-item">
                        <span class="eclt-metric-label">@L["EclipseTimer_Gamma"]</span>
                        <span class="eclt-metric-value">@m.Gamma.ToString("F4", ic)</span>
                    </div>

                    <!-- ΔT -->
                    <div class="eclt-metric-item">
                        <span class="eclt-metric-label">@L["EclipseTimer_DeltaT"]</span>
                        <span class="eclt-metric-value">
                            @m.DeltaTSeconds.ToString("F1", ic) @L["EclipseTimer_DeltaT_Unit"]
                        </span>
                    </div>

                    <!-- Duración totalidad (solo si C2 y C3 existen) -->
                    @if (m.TotalityDuration.HasValue)
                    {
                        <div class="eclt-metric-item">
                            <span class="eclt-metric-label">@L["EclipseTimer_TotalityDuration"]</span>
                            <span class="eclt-metric-value eclt-metric-value--highlight">
                                @FormatTotalityDuration(m.TotalityDuration.Value)
                            </span>
                        </div>
                    }

                    <!-- Saros -->
                    <div class="eclt-metric-item eclt-metric-item--wide">
                        <span class="eclt-metric-label">@L["EclipseTimer_Saros"]</span>
                        <span class="eclt-metric-value">
                            @m.SarosNumber
                            <span class="eclt-metric-sub">(@m.SarosMember / @m.SarosTotal)</span>
                        </span>
                    </div>

                </div>
            }

            <!-- CUENTA ATRÁS AL PRÓXIMO EVENTO -->
            @if (_nextEvent != null)
            {
                <div class="eclt-countdown-card">
                    <div class="eclt-countdown-label">@L["EclipseTimer_NextEvent"]</div>
                    <div class="eclt-countdown-event">@GetEventLabel(_nextEvent.Kind)</div>
                    <div class="eclt-countdown-time">@_countdownText</div>
                    <!-- SVG de la fase actual -->
                    <div class="eclt-phase-preview">
                        @((MarkupString)BuildPhaseSvg(_nextEvent.Kind, _nextEvent.CoverageFraction, 120, _result.Type))
                    </div>
                </div>
            }

            <!-- TIMELINE DE CONTACTOS -->
            <div class="eclt-card">
                <div class="eclt-card-header">
                    <span>⏱️</span> @L["EclipseTimer_Contacts"]

                    <!-- Botón simulación completa -->
                    <div class="eclt-header-actions">
                        @if (_simMode)
                        {
                            <button class="eclt-sim-btn eclt-sim-btn--stop"
                                    @onclick="StopSimulation">
                                ⏹ @L["EclipseTimer_SimStop"]
                            </button>
                        }
                        else
                        {
                            <button class="eclt-sim-btn"
                                    @onclick="StartSimulation"
                                    disabled="@(_result == null)">
                                ▶ @L["EclipseTimer_SimStart"]
                            </button>
                        }
                    </div>
                </div>

                @if (_simMode)
                {
                    <div class="eclt-sim-banner">
                        🎬 @L["EclipseTimer_SimActive"] — ×30
                    </div>
                }

                <div class="eclt-card-body eclt-timeline-body">
                    @foreach (var contact in _result!.Contacts)
                    {
                        bool isPast = (_simMode ? _simNow : DateTime.UtcNow) > contact.UtcTime;
                        bool isNext = _nextEvent?.Kind == contact.Kind;
                        bool isKey = contact.Kind is EclipseEventKind.C1
                                                   or EclipseEventKind.C2
                                                   or EclipseEventKind.Maximum
                                                   or EclipseEventKind.C3
                                                   or EclipseEventKind.C4;

                        <div class="eclt-event-row @(isPast ? "past" : "") @(isNext ? "next" : "") @(isKey ? "key" : "")">

                            <!-- SVG miniatura con tipo correcto -->
                            <div class="eclt-event-svg">
                                @((MarkupString)BuildPhaseSvg(
                                    contact.Kind,
                                    contact.CoverageFraction,
                                    52,
                                    _result.Type))
                            </div>

                            <!-- Info -->
                            <div class="eclt-event-info">
                                <span class="eclt-event-name">@GetEventLabel(contact.Kind)</span>
                                <span class="eclt-event-time">
                                    @contact.UtcTime.ToLocalTime().ToString("HH:mm:ss")
                                </span>
                                <span class="eclt-event-alt">
                                    @L["EclipseTimer_Altitude"]: @contact.SunAltitudeDeg.ToString("F1")°
                                </span>
                            </div>

                            <!-- Cuenta atrás + botón test -->
                            <div class="eclt-event-right">
                                <div class="eclt-event-countdown @(isPast ? "done" : "")">
                                    @FormatCountdown(contact.UtcTime)
                                </div>
                                <button class="eclt-test-btn"
                                        title="@L["EclipseTimer_TestAlert"]"
                                        @onclick="() => TestEventAlertAsync(contact)">
                                    🔔
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- GRÁFICO TIMELINE VISUAL -->
            <div class="eclt-card">
                <div class="eclt-card-header">
                    <span>🌘</span> @L["EclipseTimer_TimelineTitle"]
                </div>
                <div class="eclt-card-body">
                    @((MarkupString)BuildTimelineSvg())
                </div>
            </div>
        }
    }

</div>

@code {

    // ── Estado ────────────────────────────────────────────────────────────────
    private List<EclipseDefinition> _eclipses = new();
    private EclipseDefinition?      _selectedEclipse;
    private LocalEclipseResult?     _result;
    private List<FavoriteLocation>? _favLocations;

    // ── Simulación ────────────────────────────────────────────────────────────
    private bool _simMode = false;
    private DateTime _simNow = DateTime.UtcNow;
    private Timer? _simTimer;
    private string _simBtnLabel = string.Empty;

    private double _lat =  40.4168;
    private double _lon =  -3.7038;
    private double _alt =  650;

    private bool    _gpsLoading;
    private string? _gpsError;
    private string? _gpsSourceLabel;
    private bool    _audioEnabled = true;

    // ── Disparo automático de cámara ──────────────────────────────────────────
    private int _photosPerEvent = 3;
    private bool _cameraAutoEnabled;
    private bool _cameraConnecting;
    private string? _cameraStatusText;
    private List<EclipseExposureCalculator.PhaseExposure>? _cameraTable;
    private readonly HashSet<EclipseEventKind> _cameraTriggeredEvents = new();

    // Cuenta atrás
    private EclipseContact? _nextEvent;
    private string          _countdownText = "--:--:--:--";
    private Timer?          _timer;

    // ── Inicialización ────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        _eclipses = EclipseCalc.GetUpcomingEclipses(6).ToList();

        // Seleccionar automáticamente el próximo eclipse futuro
        _selectedEclipse = _eclipses.FirstOrDefault(e => e.Date > DateTime.UtcNow)
                        ?? _eclipses.FirstOrDefault();

        _favLocations = await FavLocationsService.GetFavoriteLocationsAsync();

        // Si hay un eclipse seleccionado, calcular directamente
        if (_selectedEclipse != null)
            CalculateEclipse();

        // Timer para actualizar cuentas atrás cada segundo
        _timer = new Timer(_ => InvokeAsync(() =>
        {
            UpdateNextEvent();
            StateHasChanged();
        }), null, 0, 1000);
    }

    // ── Selección de eclipse ──────────────────────────────────────────────────
    private void SelectEclipse(EclipseDefinition ecl)
    {
        _selectedEclipse = ecl;
        _result = null;
        CalculateEclipse();
    }

    // ── Ubicación ─────────────────────────────────────────────────────────────
    private async Task OnUseGpsAsync()
    {
        _gpsLoading = true;
        _gpsError   = null;
        StateHasChanged();

        var loc = await GeoService.GetCurrentLocationAsync(highAccuracy: true);
        if (loc != null)
        {
            _lat = loc.Latitude;
            _lon = loc.Longitude;
            _alt = loc.AltitudeMeters ?? _alt;
            _gpsSourceLabel = $"{loc.SourceLabel} · {_lat:F4}°, {_lon:F4}°";
            CalculateEclipse();
        }
        else
        {
            _gpsError = GeoService.LastError;
        }

        _gpsLoading = false;
        StateHasChanged();
    }

    private async Task OnFavLocationChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        if (val == "gps")
        {
            await OnUseGpsAsync();
            return;
        }
        if (Guid.TryParse(val, out var id))
        {
            var loc = _favLocations?.Find(l => l.Id == id);
            if (loc != null)
            {
                _lat = loc.Latitude;
                _lon = loc.Longitude;
                _alt = loc.AltitudeMeters;
                _gpsSourceLabel = $"⭐ {loc.Name}";
                _gpsError = null;
                CalculateEclipse();
            }
        }
    }

    // ── Cálculo ───────────────────────────────────────────────────────────────
    private void CalculateEclipse()
    {
        if (_selectedEclipse == null) return;
        _result = EclipseCalc.Calculate(_selectedEclipse, _lat, _lon, _alt);
        _cameraTriggeredEvents.Clear();

        UpdateNextEvent();
    }

    private void UpdateNextEvent()
    {
        if (_result == null) return;

        // En modo simulación usamos el tiempo simulado
        var now = _simMode ? _simNow : DateTime.UtcNow;
        _ = CheckAndTriggerCameraAsync(now);

        _nextEvent = _result.Contacts
            .Where(c => c.UtcTime > now)
            .OrderBy(c => c.UtcTime)
            .FirstOrDefault();

        if (_nextEvent != null)
        {
            var diff = _nextEvent.UtcTime - now;
            _countdownText = FormatDiff(diff);

            // Aviso sonoro cuando falten ≤ 30s
            if (_audioEnabled && diff.TotalSeconds is > 0 and <= 30)
                _ = TriggerAudioAlertAsync(_nextEvent.Kind);
        }
    }

    // Ocultación máxima: busca el contacto Maximum; si no existe, usa el mayor CoverageFraction
    private double MaxCoveragePercent
    {
        get
        {
            if (_result == null) return 0;
            var maxContact = _result.Contacts
                .FirstOrDefault(c => c.Kind == EclipseEventKind.Maximum);
            if (maxContact != null && maxContact.CoverageFraction > 0)
                return maxContact.CoverageFraction;
            // Fallback: el mayor valor disponible entre todos los contactos
            return _result.Contacts.Count > 0
                ? _result.Contacts.Max(c => c.CoverageFraction)
                : 0;
        }
    }

    // ── Formateador unificado de diferencias de tiempo ─────────────────────────
    private string FormatDiff(TimeSpan diff)
    {
        if (diff.TotalSeconds <= 0)
            return L["EclipseTimer_Now"];

        if (diff.TotalDays >= 1)
        {
            int days = (int)diff.TotalDays;
            int hours = diff.Hours;
            int mins = diff.Minutes;
            int secs = diff.Seconds;
            return $"{days}{L["EclipseTimer_Days"]} {hours}{L["EclipseTimer_Hours"]} {mins:D2}{L["EclipseTimer_Minutes"]} {secs:D2}{L["EclipseTimer_Seconds"]}";
        }

        if (diff.TotalHours >= 1)
            return $"{(int)diff.TotalHours}{L["EclipseTimer_Hours"]} " +
                   $"{diff.Minutes:D2}{L["EclipseTimer_Minutes"]} " +
                   $"{diff.Seconds:D2}{L["EclipseTimer_Seconds"]}";

        return $"{diff.Minutes:D2}:{diff.Seconds:D2}";
    }

    // FormatCountdown para cada fila de evento
    private string FormatCountdown(DateTime utc)
    {
        var now = _simMode ? _simNow : DateTime.UtcNow;
        var diff = utc - now;

        if (diff.TotalSeconds < -60) return L["EclipseTimer_Ago"];
        if (diff.TotalSeconds <= 0) return L["EclipseTimer_Now"];

        var prefix = L["EclipseTimer_In"].Value;
        return $"{prefix} {FormatDiff(diff)}";
    }

    // ── Audio ─────────────────────────────────────────────────────────────────
    private void ToggleAudio() => _audioEnabled = !_audioEnabled;

    private readonly HashSet<EclipseEventKind> _announcedEvents = new();

    private async Task TriggerAudioAlertAsync(EclipseEventKind kind)
    {
        if (_announcedEvents.Contains(kind)) return;
        _announcedEvents.Add(kind);

        var message = kind switch
        {
            EclipseEventKind.C1               => L["Eclipse_Alert_C1"].Value,
            EclipseEventKind.ShadowBands      => L["Eclipse_Alert_ShadowBands"].Value,
            EclipseEventKind.BailyBeadsStart  => L["Eclipse_Alert_BailyStart"].Value,
            EclipseEventKind.DiamondRingStart => L["Eclipse_Alert_DiamondStart"].Value,
            EclipseEventKind.C2               => L["Eclipse_Alert_C2"].Value,
            EclipseEventKind.Maximum          => L["Eclipse_Alert_Maximum"].Value,
            EclipseEventKind.C3               => L["Eclipse_Alert_C3"].Value,
            EclipseEventKind.DiamondRingEnd   => L["Eclipse_Alert_DiamondEnd"].Value,
            EclipseEventKind.BailyBeadsEnd    => L["Eclipse_Alert_BailyEnd"].Value,
            EclipseEventKind.C4               => L["Eclipse_Alert_C4"].Value,
            _                                 => string.Empty
        };

        if (!string.IsNullOrEmpty(message))
            await AudioService.AnnounceEventAsync(message);
    }

    // ── Helpers de etiquetas ──────────────────────────────────────────────────
    private string GetEventLabel(EclipseEventKind kind) => kind switch
    {
        EclipseEventKind.C1               => L["Eclipse_C1"],
        EclipseEventKind.C2               => L["Eclipse_C2"],
        EclipseEventKind.C3               => L["Eclipse_C3"],
        EclipseEventKind.C4               => L["Eclipse_C4"],
        EclipseEventKind.ShadowBands      => L["Eclipse_ShadowBands"],
        EclipseEventKind.BailyBeadsStart  => L["Eclipse_BailyBeadsStart"],
        EclipseEventKind.BailyBeadsEnd    => L["Eclipse_BailyBeadsEnd"],
        EclipseEventKind.DiamondRingStart => L["Eclipse_DiamondRingStart"],
        EclipseEventKind.DiamondRingEnd   => L["Eclipse_DiamondRingEnd"],
        EclipseEventKind.Maximum          => L["Eclipse_Maximum"],
        _                                 => kind.ToString()
    };

    private string GetTypeLabel(EclipseType t) => t switch
    {
        EclipseType.Total   => L["EclipseTimer_Type_Total"],
        EclipseType.Annular => L["EclipseTimer_Type_Annular"],
        EclipseType.Hybrid  => L["EclipseTimer_Type_Annular"], // tratar hybrid como anular visualmente
        _                   => L["EclipseTimer_Type_Partial"]
    };

    private string GetLocalTypeLabel(LocalEclipseType t) => t switch
    {
        LocalEclipseType.Total   => L["EclipseTimer_Type_Total"],
        LocalEclipseType.Annular => L["EclipseTimer_Type_Annular"],
        _                        => L["EclipseTimer_Type_Partial"]
    };

    private string GetLocalTypeEmoji(LocalEclipseType t) => t switch
    {
        LocalEclipseType.Total   => "🌑",
        LocalEclipseType.Annular => "💍",
        _                        => "🌒"
    };

    private string GetTypeCssClass(EclipseType t) => t switch
    {
        EclipseType.Total   => "total",
        EclipseType.Annular => "annular",
        EclipseType.Hybrid  => "annular",
        _                   => "partial"
    };

    private static string FormatTotalityDuration(TimeSpan ts)
    {
        if (ts.TotalMinutes >= 1)
            return $"{(int)ts.TotalMinutes}m {ts.Seconds:D2}s";
        return $"{ts.Seconds}s";
    }

    // ── SVGs de fases ─────────────────────────────────────────────────────────
    private static string BuildPhaseSvg(
     EclipseEventKind kind,
     double coverage,
     int size,
     LocalEclipseType localType = LocalEclipseType.Partial)
    {
        var ic = CultureInfo.InvariantCulture;
        int cx = size / 2;
        int cy = size / 2;
        int r = (int)(size * 0.40);

        var sb = new System.Text.StringBuilder();
        sb.Append($"<svg width=\"{size}\" height=\"{size}\" " +
                  $"viewBox=\"0 0 {size} {size}\" " +
                  $"xmlns=\"http://www.w3.org/2000/svg\">");
        // Fondo
        sb.Append($"<circle cx=\"{cx}\" cy=\"{cy}\" r=\"{size / 2 - 1}\" fill=\"#050d1a\"/>");

        switch (kind)
        {
            // ── C1: Sol casi completo, Luna entrando por la derecha ──────────────
            case EclipseEventKind.C1:
                sb.Append(SunDisk(cx, cy, r, ic));
                int c1MoonOff = (int)(r * 1.72);
                sb.Append($"<circle cx=\"{cx + c1MoonOff}\" cy=\"{cy}\" " +
                          $"r=\"{(int)(r * 0.95)}\" fill=\"#050d1a\"/>");
                break;

            // ── C2: inicio de totalidad — disco negro puro ───────────────────────
            case EclipseEventKind.C2 when localType == LocalEclipseType.Total:
                sb.Append($"<circle cx=\"{cx}\" cy=\"{cy}\" r=\"{r}\" fill=\"#111\"/>");
                // Borde tenue que indica el Sol detrás
                sb.Append($"<circle cx=\"{cx}\" cy=\"{cy}\" r=\"{r + 2}\" " +
                          $"fill=\"none\" stroke=\"rgba(245,158,11,0.35)\" stroke-width=\"2\"/>");
                break;

            // ── C2 anular: inicio del anillo ─────────────────────────────────────
            case EclipseEventKind.C2 when localType == LocalEclipseType.Annular:
                sb.Append(AnnularRingSvg(cx, cy, r, ic));
                break;

            // ── Maximum total: disco negro + corona ──────────────────────────────
            case EclipseEventKind.Maximum when localType == LocalEclipseType.Total:
                sb.Append(BuildCoronaSvg(cx, cy, r, size, ic));
                sb.Append($"<circle cx=\"{cx}\" cy=\"{cy}\" r=\"{r}\" fill=\"#080808\"/>");
                break;

            // ── Maximum anular: anillo de fuego prominente ───────────────────────
            case EclipseEventKind.Maximum when localType == LocalEclipseType.Annular:
                sb.Append(AnnularRingSvg(cx, cy, r, ic, prominent: true));
                break;

            // ── Maximum parcial: ocultación parcial ──────────────────────────────
            case EclipseEventKind.Maximum:
                sb.Append(BuildGenericPartialSvg(cx, cy, r, coverage, ic));
                break;

            // ── C3: fin de totalidad — disco negro (igual que C2) ────────────────
            case EclipseEventKind.C3 when localType == LocalEclipseType.Total:
                sb.Append($"<circle cx=\"{cx}\" cy=\"{cy}\" r=\"{r}\" fill=\"#111\"/>");
                sb.Append($"<circle cx=\"{cx}\" cy=\"{cy}\" r=\"{r + 2}\" " +
                          $"fill=\"none\" stroke=\"rgba(245,158,11,0.35)\" stroke-width=\"2\"/>");
                break;

            case EclipseEventKind.C3 when localType == LocalEclipseType.Annular:
                sb.Append(AnnularRingSvg(cx, cy, r, ic));
                break;

            // ── C4: Sol casi completo, Luna saliendo por la izquierda ────────────
            case EclipseEventKind.C4:
                sb.Append(SunDisk(cx, cy, r, ic));
                int c4MoonOff = (int)(r * 1.72);
                sb.Append($"<circle cx=\"{cx - c4MoonOff}\" cy=\"{cy}\" " +
                          $"r=\"{(int)(r * 0.95)}\" fill=\"#050d1a\"/>");
                break;

            // ── Anillo de diamante ───────────────────────────────────────────────
            case EclipseEventKind.DiamondRingStart:
            case EclipseEventKind.DiamondRingEnd:
                sb.Append(BuildCoronaSvg(cx, cy, r, size, ic));
                sb.Append($"<circle cx=\"{cx}\" cy=\"{cy}\" r=\"{r}\" fill=\"#080808\"/>");
                int dpx = kind == EclipseEventKind.DiamondRingStart
                    ? cx - r + 3 : cx + r - 3;
                // Halo del diamante
                sb.Append($"<circle cx=\"{dpx}\" cy=\"{cy}\" r=\"{r / 4}\" " +
                          $"fill=\"rgba(255,240,180,0.25)\"/>");
                // Punto brillante
                sb.Append($"<circle cx=\"{dpx}\" cy=\"{cy}\" r=\"{r / 7}\" " +
                          $"fill=\"white\" opacity=\"0.97\"/>");
                break;

            // ── Collar de Baily ──────────────────────────────────────────────────
            case EclipseEventKind.BailyBeadsStart:
            case EclipseEventKind.BailyBeadsEnd:
                sb.Append($"<circle cx=\"{cx}\" cy=\"{cy}\" r=\"{r}\" fill=\"#080808\"/>");
                int beadSide = kind == EclipseEventKind.BailyBeadsStart ? -1 : 1;
                var beadRng = new Random(7);
                for (int i = -3; i <= 3; i++)
                {
                    double ang = i * 0.22;
                    double bx = cx + beadSide * (r - 1) * Math.Cos(ang);
                    double by = cy + (r - 1) * Math.Sin(ang);
                    double br = 1.8 + (3 - Math.Abs(i)) * 0.6 + beadRng.NextDouble() * 0.5;
                    double op = 0.6 + (3 - Math.Abs(i)) * 0.1;
                    sb.Append($"<circle cx=\"{bx.ToString("F1", ic)}\" " +
                              $"cy=\"{by.ToString("F1", ic)}\" " +
                              $"r=\"{br.ToString("F1", ic)}\" " +
                              $"fill=\"white\" opacity=\"{op.ToString("F2", ic)}\"/>");
                }
                break;

            // ── Bandas de sombra ─────────────────────────────────────────────────
            case EclipseEventKind.ShadowBands:
                sb.Append($"<circle cx=\"{cx}\" cy=\"{cy}\" r=\"{r}\" " +
                          $"fill=\"#f59e0b\" opacity=\"0.12\"/>");
                sb.Append($"<circle cx=\"{cx}\" cy=\"{cy}\" " +
                          $"r=\"{(int)(r * 0.97)}\" fill=\"#080808\"/>");
                for (int b = -3; b <= 3; b++)
                {
                    int by2 = cy + b * (size / 9);
                    sb.Append($"<line x1=\"0\" y1=\"{by2}\" x2=\"{size}\" y2=\"{by2}\" " +
                              $"stroke=\"rgba(255,255,255,0.13)\" stroke-width=\"2\"/>");
                }
                break;

            // ── Genérico parcial ─────────────────────────────────────────────────
            default:
                sb.Append(BuildGenericPartialSvg(cx, cy, r,
                    Math.Max(0.01, coverage), ic));
                break;
        }

        sb.Append("</svg>");
        return sb.ToString();
    }

    // ── Helpers SVG ──────────────────────────────────────────────────────────────

    private static string SunDisk(int cx, int cy, int r, IFormatProvider ic)
        => $"<circle cx=\"{cx}\" cy=\"{cy}\" r=\"{r}\" fill=\"#f59e0b\" opacity=\"0.92\"/>";

    /// <summary>Anillo de fuego para eclipses anulares.</summary>
    private static string AnnularRingSvg(int cx, int cy, int r,
        IFormatProvider ic, bool prominent = false)
    {
        var sb = new System.Text.StringBuilder();
        // Halo exterior tenue
        double halo = prominent ? 0.22 : 0.12;
        sb.Append($"<circle cx=\"{cx}\" cy=\"{cy}\" r=\"{(int)(r * 1.18)}\" " +
                  $"fill=\"rgba(245,130,20,{halo.ToString("F2", ic)})\"/>");
        // Anillo solar visible
        sb.Append($"<circle cx=\"{cx}\" cy=\"{cy}\" r=\"{r}\" fill=\"#f59e0b\" opacity=\"0.92\"/>");
        // Disco lunar negro (ligeramente menor que el Sol → anular)
        int moonR = (int)(r * (prominent ? 0.82 : 0.84));
        sb.Append($"<circle cx=\"{cx}\" cy=\"{cy}\" r=\"{moonR}\" fill=\"#050d1a\"/>");
        // Borde interior del anillo: resplandor cálido
        sb.Append($"<circle cx=\"{cx}\" cy=\"{cy}\" r=\"{moonR}\" " +
                  $"fill=\"none\" stroke=\"rgba(255,160,30,{(prominent ? "0.55" : "0.35")})\" " +
                  $"stroke-width=\"{(prominent ? 3 : 2)}\"/>");
        return sb.ToString();
    }

    private static string BuildGenericPartialSvg(
        int cx, int cy, int r, double coverage, IFormatProvider ic)
    {
        var sb = new System.Text.StringBuilder();
        sb.Append($"<circle cx=\"{cx}\" cy=\"{cy}\" r=\"{r}\" " +
                  $"fill=\"#f59e0b\" opacity=\"0.92\"/>");
        // Offset de la Luna según cobertura (0 = sin tapar, 1 = tapado total)
        double offset = r * (1.0 - coverage * 1.75);
        int moonX = (int)(cx - offset);
        sb.Append($"<circle cx=\"{moonX}\" cy=\"{cy}\" " +
                  $"r=\"{(int)(r * 0.97)}\" fill=\"#050d1a\"/>");
        return sb.ToString();
    }

    private static string BuildCoronaSvg(int cx, int cy, int r, int size, IFormatProvider ic)
    {
        var sb = new System.Text.StringBuilder();
        // Resplandor de la corona
        sb.Append($"<circle cx=\"{cx}\" cy=\"{cy}\" r=\"{(int)(r * 1.6)}\" fill=\"rgba(255,200,100,0.06)\"/>");
        sb.Append($"<circle cx=\"{cx}\" cy=\"{cy}\" r=\"{(int)(r * 1.3)}\" fill=\"rgba(255,200,100,0.10)\"/>");
        sb.Append($"<circle cx=\"{cx}\" cy=\"{cy}\" r=\"{(int)(r * 1.15)}\" fill=\"rgba(255,220,120,0.18)\"/>");
        // Rayos de corona
        var rng = new Random(42);
        for (int i = 0; i < 12; i++)
        {
            double ang = i * Math.PI / 6 + rng.NextDouble() * 0.3;
            double len = r * (1.15 + rng.NextDouble() * 0.6);
            double x2  = cx + len * Math.Cos(ang);
            double y2  = cy + len * Math.Sin(ang);
            sb.Append($"<line x1=\"{cx}\" y1=\"{cy}\" x2=\"{x2.ToString("F1", ic)}\" y2=\"{y2.ToString("F1", ic)}\" stroke=\"rgba(255,220,100,0.25)\" stroke-width=\"{(1 + rng.NextDouble()).ToString("F1", ic)}\"/>");
        }
        return sb.ToString();
    }

    private static string BuildPartialSvg(int cx, int cy, int r, double coverage, IFormatProvider ic, System.Text.StringBuilder _)
    {
        return BuildGenericPartialSvg(cx, cy, r, coverage, ic);
    }

    // ── Timeline SVG horizontal ───────────────────────────────────────────────
    private string BuildTimelineSvg()
    {
        if (_result == null || _result.Contacts.Count < 2)
            return "<p style='color:var(--obs-comet);text-align:center'>—</p>";

        var ic = CultureInfo.InvariantCulture;
        var contacts = _result.Contacts;
        int count = contacts.Count;

        int W = 560;
        int H = count > 6 ? 160 : 130;
        int lineY = H / 2;
        int iconSize = 28; // tamaño del mini-SVG de fase
        int marginX = 30;
        double step = count > 1 ? (W - marginX * 2.0) / (count - 1) : 0;

        var sb = new System.Text.StringBuilder();
        sb.Append($"<svg width=\"100%\" viewBox=\"0 0 {W} {H}\" " +
                  $"xmlns=\"http://www.w3.org/2000/svg\">");

        // ── Línea base ────────────────────────────────────────────────────────
        sb.Append($"<line x1=\"{marginX}\" y1=\"{lineY}\" x2=\"{W - marginX}\" y2=\"{lineY}\" " +
                  $"stroke=\"var(--obs-border)\" stroke-width=\"2\"/>");

        // ── Franja de totalidad / anularidad entre C2 y C3 ───────────────────
        if (_result.Type is LocalEclipseType.Total or LocalEclipseType.Annular)
        {
            int idxC2 = contacts.FindIndex(c => c.Kind == EclipseEventKind.C2);
            int idxC3 = contacts.FindIndex(c => c.Kind == EclipseEventKind.C3);
            if (idxC2 >= 0 && idxC3 >= 0)
            {
                double x2 = marginX + idxC2 * step;
                double x3 = marginX + idxC3 * step;
                string fc = _result.Type == LocalEclipseType.Total
                    ? "rgba(46,196,182,0.18)" : "rgba(244,196,48,0.15)";
                sb.Append($"<rect x=\"{x2.ToString("F0", ic)}\" y=\"{lineY - 12}\" " +
                          $"width=\"{(x3 - x2).ToString("F0", ic)}\" height=\"24\" " +
                          $"fill=\"{fc}\" rx=\"3\"/>");
            }
        }

        // ── Eventos distribuidos uniformemente ────────────────────────────────
        for (int i = 0; i < count; i++)
        {
            var c = contacts[i];
            double x = marginX + i * step;
            string xStr = x.ToString("F0", ic);

            bool isKey = c.Kind is EclipseEventKind.C1 or EclipseEventKind.C2
                                or EclipseEventKind.Maximum
                                or EclipseEventKind.C3 or EclipseEventKind.C4;

            bool labelAbove = (i % 2 == 0);
            int textY = labelAbove ? lineY - 26 : lineY + 32;
            int timeY = labelAbove ? lineY - 15 : lineY + 21;
            int tickY1 = labelAbove ? lineY - 7 : lineY + 7;
            int tickY2 = labelAbove ? lineY - 11 : lineY + 11;

            string dotColor = isKey ? "var(--obs-star)" : "var(--obs-comet)";
            string textColor = isKey ? "var(--obs-star)" : "var(--obs-comet)";

            if (isKey)
            {
                // ── Icono de fase incrustado ──────────────────────────────────
                // Extraemos el interior del SVG generado por BuildPhaseSvg y lo
                // posicionamos centrado sobre la línea con un <g transform>
                string phaseSvg = BuildPhaseSvg(c.Kind, c.CoverageFraction,
                                                iconSize, _result.Type);
                string phaseInner = ExtractSvgInner(phaseSvg);
                double gx = x - iconSize / 2.0;
                double gy = lineY - iconSize / 2.0;
                sb.Append($"<g transform=\"translate({gx.ToString("F1", ic)},{gy.ToString("F1", ic)})\">");
                sb.Append(phaseInner);
                sb.Append("</g>");
            }
            else
            {
                // Punto pequeño para eventos secundarios
                sb.Append($"<circle cx=\"{xStr}\" cy=\"{lineY}\" r=\"3\" " +
                          $"fill=\"{dotColor}\" opacity=\"0.6\"/>");
            }

            // Tick vertical
            sb.Append($"<line x1=\"{xStr}\" y1=\"{tickY1}\" " +
                      $"x2=\"{xStr}\" y2=\"{tickY2}\" " +
                      $"stroke=\"{dotColor}\" stroke-width=\"1\" opacity=\"0.5\"/>");

            // Hora
            string timeStr = c.UtcTime.ToLocalTime().ToString("HH:mm:ss");
            sb.Append($"<text x=\"{xStr}\" y=\"{timeY}\" " +
                      $"text-anchor=\"middle\" fill=\"{textColor}\" " +
                      $"font-size=\"7\">{timeStr}</text>");

            // Etiqueta nombre
            string label = GetEventLabel(c.Kind);

            // string label = c.Kind switch
            // {
            //     EclipseEventKind.C1 => "C1",
            //     EclipseEventKind.C2 => "C2",
            //     EclipseEventKind.C3 => "C3",
            //     EclipseEventKind.C4 => "C4",
            //     EclipseEventKind.Maximum => "MAX",
            //     EclipseEventKind.ShadowBands => "Bandas",
            //     EclipseEventKind.BailyBeadsStart => "Baily▶",
            //     EclipseEventKind.BailyBeadsEnd => "◀Baily",
            //     EclipseEventKind.DiamondRingStart => "💍▶",
            //     EclipseEventKind.DiamondRingEnd => "◀💍",
            //     _ => c.Kind.ToString()
            // };

            sb.Append($"<text x=\"{xStr}\" y=\"{textY}\" " +
                      $"text-anchor=\"middle\" fill=\"{textColor}\" " +
                      $"font-size=\"{(isKey ? 8 : 7)}\" " +
                      $"{(isKey ? "font-weight=\"700\"" : "")}>{label}</text>");
        }

        sb.Append("</svg>");
        return sb.ToString();
    }

    /// <summary>
    /// Extrae el contenido interior de un SVG generado por BuildPhaseSvg
    /// (todo excepto el tag svg exterior) para poder incrustarlo en otro SVG.
    /// </summary>
    private static string ExtractSvgInner(string svg)
    {
        int start = svg.IndexOf('>') + 1;           // fin del tag <svg ...>
        int end = svg.LastIndexOf("</svg>");       // inicio del cierre
        if (start <= 0 || end <= start) return svg;
        return svg[start..end];
    }

    // ── Test de aviso individual ───────────────────────────────────────────────
    private async Task TestEventAlertAsync(EclipseContact contact)
    {
        await AudioService.AnnounceEventAsync(GetAlertMessage(contact.Kind));
    }

    // Extraer el texto de alerta a método para reutilizar
    private string GetAlertMessage(EclipseEventKind kind) => kind switch
    {
        EclipseEventKind.C1 => L["Eclipse_Alert_C1"].Value,
        EclipseEventKind.ShadowBands => L["Eclipse_Alert_ShadowBands"].Value,
        EclipseEventKind.BailyBeadsStart => L["Eclipse_Alert_BailyStart"].Value,
        EclipseEventKind.DiamondRingStart => L["Eclipse_Alert_DiamondStart"].Value,
        EclipseEventKind.C2 => L["Eclipse_Alert_C2"].Value,
        EclipseEventKind.Maximum => L["Eclipse_Alert_Maximum"].Value,
        EclipseEventKind.C3 => L["Eclipse_Alert_C3"].Value,
        EclipseEventKind.DiamondRingEnd => L["Eclipse_Alert_DiamondEnd"].Value,
        EclipseEventKind.BailyBeadsEnd => L["Eclipse_Alert_BailyEnd"].Value,
        EclipseEventKind.C4 => L["Eclipse_Alert_C4"].Value,
        _ => string.Empty
    };

    // ── Simulación completa ────────────────────────────────────────────────────
    private void StartSimulation()
    {
        if (_result == null || _result.Contacts.Count == 0) return;

        // Detener simulación previa si la hubiera
        StopSimulation();

        // Punto de arranque: C1 real - 5 segundos, comprimido
        // La simulación acelera el tiempo: 1 segundo real = 30 segundos simulados
        // Así un eclipse de 3h se recorre en 6 minutos.
        // Pero para no esperar, usamos offset: simulamos que "ahora" es C1 - 5s
        var c1 = _result.Contacts.First();
        _simNow = c1.UtcTime.AddSeconds(-5);
        _simMode = true;
        _announcedEvents.Clear();
        _cameraTriggeredEvents.Clear();

        const double speedFactor = 30.0; // 1s real = 30s simulados

        _simTimer = new Timer(_ => InvokeAsync(() =>
        {
            _simNow = _simNow.AddSeconds(speedFactor);

            // Avisos: cuando en tiempo simulado falten ≤ 30s para un evento
            if (_audioEnabled)
            {
                foreach (var contact in _result.Contacts)
                {
                    var diff = contact.UtcTime - _simNow;
                    if (diff.TotalSeconds is > 0 and <= 30)
                        _ = TriggerAudioAlertAsync(contact.Kind);
                }
            }

            // Fin: cuando superamos el último evento
            var lastEvent = _result.Contacts.Last();
            if (_simNow > lastEvent.UtcTime.AddSeconds(30))
                StopSimulation();

            UpdateNextEvent();
            StateHasChanged();
        }), null, 0, 1000);
    }

    private void StopSimulation()
    {
        _simTimer?.Dispose();
        _simTimer = null;
        _simMode = false;
        _announcedEvents.Clear();
        UpdateNextEvent();
    }

    // ── Disparo automático de cámara ──────────────────────────────────────────
    protected override void OnInitialized()
    {
        // La página ya tiene OnInitializedAsync (carga eclipses + timer) — este
        // OnInitialized() es un método DISTINTO de ComponentBase, no hay conflicto.
        CameraProfile.OnChanged += RebuildCameraTable;
        RebuildCameraTable();
    }

    private void RebuildCameraTable()
    {
        _cameraTable = CameraProfile.IsConfigured
            ? EclipseExposureCalculator.BuildTable(CameraProfile.ApertureFNumber, CameraProfile.Iso)
            : null;
        InvokeAsync(StateHasChanged);
    }

    private async Task OnConnectCameraAsync()
    {
        _cameraConnecting = true;
        StateHasChanged();
        await CameraDevice.ConnectAsync();
        _cameraConnecting = false;
        StateHasChanged();
    }

    private async Task CheckAndTriggerCameraAsync(DateTime now)
    {
        if (!_cameraAutoEnabled || _cameraTable is null || _result is null) return;

        foreach (var contact in _result.Contacts)
        {
            if (_cameraTriggeredEvents.Contains(contact.Kind)) continue;

            var diff = (now - contact.UtcTime).TotalSeconds;
            if (diff < 0 || diff > 2) continue; // aún no llega, o ya pasó de sobra

            _cameraTriggeredEvents.Add(contact.Kind);
            await FireCameraForEventAsync(contact.Kind);
        }
    }

    private async Task FireCameraForEventAsync(EclipseEventKind kind)
    {
        if (_cameraTable is null) return;

        if (kind == EclipseEventKind.C2)
        {
            var bracket = EclipseExposureCalculator.GetTotalityBracket(_cameraTable);
            if (bracket.Count == 0) return;

            _cameraStatusText = $"Bracket de corona iniciado ({bracket.Count} tomas × {_photosPerEvent})";
            await CameraManager.RunEclipseSequenceAsync(_photosPerEvent, isTotality: true, bracket);
            return;
        }

        var setting = EclipseExposureCalculator.ResolveSingleEventExposure(kind, _cameraTable);
        if (setting is null) return; // Maximum y C3: sin acción propia (ver EclipseExposureCalculator)

        _cameraStatusText = $"{GetEventLabel(kind)} → {setting}";
        await CameraManager.RunEclipseSequenceAsync(_photosPerEvent, isTotality: false, new[] { setting });
    }

    // ── Dispose ───────────────────────────────────────────────────────────────
    public void Dispose()
    {
        _timer?.Dispose();
        CameraProfile.OnChanged -= RebuildCameraTable;
    }
}
