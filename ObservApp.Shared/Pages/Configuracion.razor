@page "/configuracion"
@inject ILocalizationService Localization
@inject ISettingsService Settings
@inject IStringLocalizer<ObservApp.Resources.Strings.App> L
@implements IDisposable

<PageTitle>@L["Settings_Title"]</PageTitle>

<div class="cfg-page">

    <!-- Cabecera -->
    <div class="cfg-header">
        <span class="cfg-header-icon">⚙️</span>
        <h1 class="cfg-header-title">@L["Settings_Title"]</h1>
    </div>

    
    <!-- Sección ubicaciones guardadas -->
    <section class="cfg-section" style="margin-top: 25px; border-top: 1px solid var(--obs-border); padding-top: 20px;">
        <h2 class="cfg-section-title">
            <span class="cfg-section-icon">🗺️</span>
            @L["Settings_FavoriteLocations"]
        </h2>
        <p class="cfg-hint">@L["Settings_ManageLocations"]</p>

        <div style="margin-top: 15px;">
            <a href="/configuracion/ubicaciones" class="cfg-lang-card" style="text-decoration: none; display: inline-flex; justify-content: center; align-items: center; font-weight: 600; color: var(--obs-star); width: 100%; max-width: 350px;">
                🗺️ @L["Settings_ManageLocations"]
            </a>
        </div>
    </section>

    <!-- Sección idioma -->
    <section class="cfg-section">

        <h2 class="cfg-section-title">
            <span class="cfg-section-icon">🌐</span>
            @L["Settings_Section_Language"]
        </h2>

        <p class="cfg-hint">@L["Settings_Language_Hint"]</p>

        <div class="cfg-lang-grid">
            @foreach (var lang in Localization.SupportedLanguages)
            {
                <button class="cfg-lang-card @(lang.Code == _selectedCode ? "selected" : string.Empty)"
                        @onclick="() => SelectLanguage(lang.Code)"
                        aria-pressed="@(lang.Code == _selectedCode)">
                    <span class="cfg-lang-flag">@lang.Flag</span>
                    <span class="cfg-lang-name">@lang.Name</span>
                    @if (lang.Code == _selectedCode)
                    {
                        <span class="cfg-lang-check" aria-hidden="true">✓</span>
                    }
                </button>
            }
        </div>

        <!-- Feedback -->
        @if (_isReloading)
        {
            <div class="cfg-toast cfg-toast--ok" role="status">
                ⏳ @L["Settings_Language_Applying"]
            </div>
        }

    </section>

</div>

@code {
    private string _selectedCode = string.Empty;
    private bool _isReloading;

    protected override void OnInitialized()
    {
        _selectedCode = Localization.CurrentLanguageCode;
        Localization.OnLanguageChanged += OnLanguageChanged;
    }

    private void SelectLanguage(string code)
    {
        if (code == Localization.CurrentLanguageCode)
            return;

        _selectedCode = code;
        _isReloading = true;          // ← mostrar feedback antes de recargar
        StateHasChanged();

        Settings.SetLanguage(code);
        Localization.SetLanguage(code); // en web esto recarga la página
    }

    private void OnLanguageChanged()
    {
        _selectedCode = Localization.CurrentLanguageCode;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Localization.OnLanguageChanged -= OnLanguageChanged;
}
